{%- assign widget = section.settings.widget_type | default: 'judgeme_reviews_widget' -%}

<section class="lbs lbs-prod-reviews" id="lbs-reviews">
  <div class="lbs-prod-reviews__wrap">
    {%- if widget == 'judgeme_carousel' -%}
      <div class="jdgm-widget jdgm-carousel"
           data-id="{{ product.id }}"
           data-product-title="{{ product.title | escape }}"
           data-product-handle="{{ product.handle }}"
           data-page-url="{{ shop.url }}{{ product.url }}">
      </div>
    {%- elsif widget == 'judgeme_all_reviews_widget' -%}
      {%- render 'judgeme_widgets',
          widget_type: 'judgeme_all_reviews_widget',
          concierge_install: true,
          product: product -%}
    {%- else -%}
      {%- render 'judgeme_widgets',
          widget_type: 'judgeme_reviews_widget',
          concierge_install: true,
          product: product,
          show_write_review_button: true,
          show_avatar: true,
          show_display_name: true,
          show_verified_badge: true,
          show_helpful_display: true,
          hide_if_no_reviews: false -%}
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  /* Fallback: load Judge.me JS if the app embed did not inject it.
     This fires only when window.jdgm is not already defined. */
  if (typeof window.jdgm !== 'undefined') return;
  window.jdgm = window.jdgm || {};
  window.jdgm.shop = {{ shop.permanent_domain | json }};
  {%- assign jdgm_token = shop.metafields.judgeme.public_token -%}
  {%- if jdgm_token != blank -%}
  window.jdgm.token = {{ jdgm_token | json }};
  {%- endif -%}
  if (!document.querySelector('script[src*="judge.me"]')) {
    var s = document.createElement('script');
    s.src = '//cdn.judge.me/assets/shop.js';
    s.defer = true;
    document.head.appendChild(s);
  }
})();
</script>

{% schema %}
{
  "name": "LBS Product Reviews",
  "tag": "section",
  "class": "section-lbs-product-reviews",
  "settings": [
    {
      "type": "select",
      "id": "widget_type",
      "label": "Review widget",
      "info": "Judge.me app embed must be enabled in Theme → Customize → App embeds for reviews to appear. Carousel requires Judge.me Premium.",
      "options": [
        { "value": "judgeme_reviews_widget",    "label": "Product reviews (recommended)" },
        { "value": "judgeme_carousel",           "label": "Reviews carousel (Premium)" },
        { "value": "judgeme_all_reviews_widget", "label": "All-store reviews" }
      ],
      "default": "judgeme_reviews_widget"
    }
  ],
  "presets": [{ "name": "LBS Product Reviews" }]
}
{% endschema %}
