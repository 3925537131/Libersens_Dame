{%- comment -%}
  Product reviews — uses Judge.me's SERVER-RENDERED metafield HTML, the same
  approach as the homepage testimonials carousel ({{ shop.metafields.judgeme.* }}).
  Judge.me writes the fully-rendered widget into product.metafields.judgeme.widget,
  so it shows instantly with no JS race and no app-embed dependency.

  Falls back to the JS widget only if the metafield is empty (e.g. Judge.me's
  Liquid/metafield rendering hasn't been enabled for the shop).
{%- endcomment -%}

{%- assign jm_widget = product.metafields.judgeme.widget -%}

<section class="lbs lbs-prod-reviews" id="lbs-reviews">
  <div class="lbs-prod-reviews__wrap">

    {%- if section.settings.heading != blank -%}
      <div class="lbs-prod-reviews__head">
        <h2 class="lbs-prod-reviews__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- comment -%} ===== TEMP DIAGNOSTIC — remove after debugging ===== {%- endcomment -%}
    <pre style="background:#111;color:#0f0;padding:16px;font-size:11px;white-space:pre-wrap;word-break:break-all;border-radius:8px;max-height:500px;overflow:auto">FIRST 2500 CHARS OF judgeme.widget:
{{ product.metafields.judgeme.widget | escape | truncate: 2500 }}</pre>
    {%- comment -%} ===== END DIAGNOSTIC ===== {%- endcomment -%}

    {%- if jm_widget != blank -%}
      {%- comment -%} Primary: Judge.me's pre-rendered HTML from the product metafield {%- endcomment -%}
      {{ jm_widget }}
    {%- else -%}
      {%- comment -%} Fallback: JS widget (requires shop.js / app embed) {%- endcomment -%}
      <div class="jdgm-widget jdgm-review-widget"
           data-id="{{ product.id }}"
           data-product-title="{{ product.title | escape }}"
           data-product-handle="{{ product.handle }}"
           data-page-url="{{ shop.url }}{{ product.url }}"></div>
    {%- endif -%}

  </div>
</section>

{%- comment -%}
  Only load shop.js when we had to use the JS-widget fallback. When the metafield
  HTML is present, no JavaScript is needed at all.
{%- endcomment -%}
{%- if jm_widget == blank -%}
<script>
(function () {
  function isReady() { return window.jdgm && typeof window.jdgm.loadFromFooter === 'function'; }
  function reinit() {
    if (!isReady()) return false;
    window.jdgm.loadFromFooter();
    typeof window.jdgm.replaceDeferred === 'function' && window.jdgm.replaceDeferred();
    return true;
  }
  window.jdgm      = window.jdgm      || {};
  window.jdgm.shop = window.jdgm.shop || {{ shop.permanent_domain | json }};
  {%- assign jdgm_token = shop.metafields.judgeme.public_token -%}
  {%- if jdgm_token != blank -%}
  window.jdgm.token = window.jdgm.token || {{ jdgm_token | json }};
  {%- endif -%}
  window.jdgm.onloadFunctions = window.jdgm.onloadFunctions || [];
  window.jdgm.onloadFunctions.push(reinit);
  if (reinit()) return;
  if (!document.querySelector('script[src*="judge.me"]')) {
    var s = document.createElement('script');
    s.src = '//cdn.judge.me/assets/shop.js'; s.async = true;
    document.head.appendChild(s);
  }
  var n = 0, t = setInterval(function () { if (reinit() || ++n >= 40) clearInterval(t); }, 250);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "LBS Product Reviews",
  "tag": "section",
  "class": "section-lbs-product-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" }
  ],
  "presets": [{ "name": "LBS Product Reviews" }]
}
{% endschema %}
