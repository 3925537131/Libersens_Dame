{%- comment -%}
  Product reviews — outputs Judge.me's SERVER-RENDERED widget HTML stored in
  product.metafields.judgeme.widget (same metafield approach as the homepage
  testimonials carousel). It renders instantly with no JS race.

  NOTE: Judge.me's widget HTML ships with an inline
    <style class='jdgm-temp-hiding-style'>.jdgm-rev-widg{ display:none }</style>
  that hides itself until Judge.me's shop.js removes it. Since shop.js isn't
  guaranteed on this theme, libersens.css overrides that rule (.jdgm-rev-widg
  { display:block !important }) and styles the jdgm-* classes to the brand look,
  so reviews always display with zero JS dependency.

  shop.js is still loaded best-effort below to enable the "Write a review" form
  and any interactive bits — but display does not depend on it.
{%- endcomment -%}

{%- assign jm_widget = product.metafields.judgeme.widget -%}

<section class="lbs lbs-prod-reviews" id="lbs-reviews">
  <div class="lbs-prod-reviews__wrap">

    {%- if section.settings.heading != blank -%}
      <div class="lbs-prod-reviews__head">
        <h2 class="lbs-prod-reviews__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if jm_widget != blank -%}
      {{ jm_widget }}
    {%- else -%}
      <div class="jdgm-widget jdgm-review-widget"
           data-id="{{ product.id }}"
           data-product-title="{{ product.title | escape }}"
           data-product-handle="{{ product.handle }}"
           data-page-url="{{ shop.url }}{{ product.url }}"></div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  /* Best-effort: load Judge.me shop.js to enable the Write-a-review form and
     interactive features. Display is handled by CSS, so failure here is harmless. */
  window.jdgm      = window.jdgm      || {};
  window.jdgm.shop = window.jdgm.shop || {{ shop.permanent_domain | json }};
  if (!document.querySelector('script[src*="judge.me"]')) {
    var s = document.createElement('script');
    s.src = '//cdn.judge.me/assets/shop.js';
    s.async = true;
    document.head.appendChild(s);
  }
})();
</script>

{% schema %}
{
  "name": "LBS Product Reviews",
  "tag": "section",
  "class": "section-lbs-product-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" }
  ],
  "presets": [{ "name": "LBS Product Reviews" }]
}
{% endschema %}
