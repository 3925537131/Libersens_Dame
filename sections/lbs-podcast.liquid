<section class="lbs podcast">
  <div class="wrap">
    <div class="podcast__grid">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        <div class="podcast__platforms">
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a class="platform" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- else -%}
              <span class="platform" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="podcast__art">
        {%- if section.settings.image -%}<img src="{{ section.settings.image | image_url: width: 700 }}" alt="{{ section.settings.heading | escape }}">{%- else -%}{{ section.settings.art_text }}{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LBS Podcast banner",
  "tag": "section",
  "class": "section-lbs-podcast",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Now streaming" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Talk, by Libersens" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Honest conversations about pleasure, bodies, and the things no one told us. New episodes every week." },
    { "type": "image_picker", "id": "image", "label": "Cover art (optional)" },
    { "type": "text", "id": "art_text", "label": "Cover text (when no image)", "default": "Real Talk" }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Spotify" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Podcast banner",
      "blocks": [
        { "type": "platform", "settings": { "label": "Spotify" } },
        { "type": "platform", "settings": { "label": "Apple Podcasts" } },
        { "type": "platform", "settings": { "label": "YouTube" } }
      ]
    }
  ]
}
{% endschema %}
