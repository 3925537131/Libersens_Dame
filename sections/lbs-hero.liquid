<section class="lbs lbs-hero2"
  style="--hero-min:{{ section.settings.min_height }}px;--hero-text:{{ section.settings.text_color }};--hero-overlay:{{ section.settings.overlay_opacity | at_most: 45 | divided_by: 100.0 }}">
  {%- if section.settings.image != blank -%}
    <div class="lbs-hero2__bg" style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}')"></div>
  {%- else -%}
    <div class="lbs-hero2__bg lbs-hero2__bg--fallback"></div>
  {%- endif -%}
  <div class="lbs-hero2__overlay"></div>

  <div class="wrap lbs-hero2__inner">
    <div class="lbs-hero2__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="lbs-hero2__eyebrow">
          {%- if section.settings.show_stars -%}<span class="lbs-hero2__stars">★★★★★</span>{%- endif -%}
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {%- endif -%}

      <h1 class="lbs-hero2__title">{{ section.settings.heading }}{% if section.settings.emphasis != blank %} <em>{{ section.settings.emphasis }}</em>{% endif %}{{ section.settings.heading_suffix }}</h1>

      {%- if section.settings.text != blank -%}<p class="lbs-hero2__text">{{ section.settings.text }}</p>{%- endif -%}

      {%- if section.settings.button_label_1 != blank -%}
        <div class="lbs-hero2__cta">
          <a href="{{ section.settings.button_link_1 | default: '#' }}" class="lbs-hero2__btn"
             style="background:{{ section.settings.button_bg }};color:{{ section.settings.button_text }}">{{ section.settings.button_label_1 }}</a>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="lbs-hero2__link">{{ section.settings.button_label_2 }} &rarr;</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LBS Hero",
  "tag": "section",
  "class": "section-lbs-hero",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "label": "Image darken (for text legibility)", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "min_height", "label": "Height", "min": 420, "max": 820, "step": 20, "unit": "px", "default": 640 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#f4ead9" },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_stars", "label": "Show 5 stars before eyebrow", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Over 50,000 happy customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "By Women, For Women" },
    { "type": "text", "id": "emphasis", "label": "Emphasis word (italic)" },
    { "type": "text", "id": "heading_suffix", "label": "Heading suffix" },
    { "type": "textarea", "id": "text", "label": "Paragraph", "default": "Vibrators and intimate wellness essentials — researched, developed, and designed by women for over a decade." },
    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "button_label_1", "label": "Label", "default": "Shop sex products" },
    { "type": "url", "id": "button_link_1", "label": "Link" },
    { "type": "color", "id": "button_bg", "label": "Button color", "default": "#cde000" },
    { "type": "color", "id": "button_text", "label": "Button text color", "default": "#0029FF" },
    { "type": "header", "content": "Secondary link" },
    { "type": "text", "id": "button_label_2", "label": "Label", "default": "Need help? Take the quiz" },
    { "type": "url", "id": "button_link_2", "label": "Link" }
  ],
  "presets": [{ "name": "LBS Hero" }]
}
{% endschema %}
