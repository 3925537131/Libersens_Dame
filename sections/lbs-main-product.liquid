<section class="lbs pdp-section" id="pdp-{{ section.id }}">
  <div class="wrap">
    <nav class="pdp-crumbs">
      <a href="{{ routes.root_url }}">Home</a> /
      {%- if collection.url -%}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif -%}
      <span>{{ product.title }}</span>
    </nav>

    <div class="pdp">
      <div class="pdp__gallery">
        <div class="pdp__main">
          {%- if product.featured_media -%}
            <img data-pdp-main src="{{ product.featured_media | image_url: width: 1000 }}" alt="{{ product.featured_media.alt | escape }}" width="700" height="700">
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="pdp__thumbs">
            {%- for media in product.media -%}
              <button type="button" class="pdp__thumb{% if forloop.first %} active{% endif %}" data-pdp-thumb data-src="{{ media | image_url: width: 1000 }}">
                <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" width="72" height="72" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp__info">
        {%- if product.vendor != blank and section.settings.show_vendor -%}<div class="pdp__vendor">{{ product.vendor }}</div>{%- endif -%}
        <h1 class="pdp__title">{{ product.title }}</h1>

        {%- if product.metafields.reviews.rating.value != blank -%}
          <div class="pdp__rating">
            <span class="stars">★★★★★</span>
            <span>{{ product.metafields.reviews.rating.value.rating | round: 1 }} · {{ product.metafields.reviews.rating_count }} reviews</span>
          </div>
        {%- endif -%}

        <div class="pdp__price" data-pdp-price>
          {%- assign v = product.selected_or_first_available_variant -%}
          <span class="now">{{ v.price | money }}</span>
          {%- if v.compare_at_price > v.price -%}<span class="was">{{ v.compare_at_price | money }}</span>{%- endif -%}
        </div>

        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="pdp__form" data-pdp-form>
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="pdp__option">
                <div class="pdp__option-label">{{ option.name }}</div>
                <div class="pdp__pills">
                  {%- for value in option.values -%}
                    <label class="pdp__pill">
                      <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value | escape }}" data-pdp-option{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-pdp-variant-id>

          <div class="pdp__buy">
            <div class="pdp__qty">
              <button type="button" data-pdp-qty="-1" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" data-pdp-qty-input aria-label="Quantity">
              <button type="button" data-pdp-qty="1" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" class="pdp__atc" data-pdp-atc{% unless product.available %} disabled{% endunless %}>
              <span data-pdp-atc-text>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</span>
            </button>
          </div>
        </form>

        {%- if product.description != blank -%}
          <div class="pdp__desc rte">{{ product.description }}</div>
        {%- endif -%}

        {%- if section.settings.show_perks -%}
          <ul class="pdp__perks">
            <li>Medical-grade, body-safe silicone</li>
            <li>Discreet packaging &amp; shipping</li>
            <li>60-night trial &amp; free returns</li>
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-pdp-variants-{{ section.id }}>
[
  {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "options": {{ variant.options | json }},
      "price": {{ variant.price | money | json }},
      "compare_at": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<script>
  (function () {
    var root = document.getElementById('pdp-{{ section.id }}');
    if (!root) return;
    var dataEl = document.querySelector('[data-pdp-variants-{{ section.id }}]');
    var variants = [];
    try { variants = JSON.parse(dataEl.textContent); } catch (e) {}

    var idInput = root.querySelector('[data-pdp-variant-id]');
    var priceEl = root.querySelector('[data-pdp-price]');
    var atc = root.querySelector('[data-pdp-atc]');
    var atcText = root.querySelector('[data-pdp-atc-text]');
    var mainImg = root.querySelector('[data-pdp-main]');
    var qtyInput = root.querySelector('[data-pdp-qty-input]');

    function selectedOptions() {
      var opts = [];
      root.querySelectorAll('.pdp__option').forEach(function (group) {
        var checked = group.querySelector('input[type=radio]:checked');
        if (checked) opts.push(checked.value);
      });
      return opts;
    }
    function eq(a, b) { return a.length === b.length && a.every(function (x, i) { return x === b[i]; }); }
    function currentVariant() {
      var sel = selectedOptions();
      if (sel.length === 0) return variants[0];
      for (var i = 0; i < variants.length; i++) {
        if (eq(variants[i].options.slice(0, sel.length), sel)) return variants[i];
      }
      return null;
    }
    function refresh() {
      var v = currentVariant();
      if (!v) { if (atc) { atc.disabled = true; } if (atcText) atcText.textContent = 'Unavailable'; return; }
      if (idInput) idInput.value = v.id;
      if (priceEl) {
        var html = '<span class="now">' + v.price + '</span>';
        if (v.compare_at) html += '<span class="was">' + v.compare_at + '</span>';
        priceEl.innerHTML = html;
      }
      if (atc) atc.disabled = !v.available;
      if (atcText) atcText.textContent = v.available ? 'Add to cart' : 'Sold out';
    }

    root.querySelectorAll('[data-pdp-option]').forEach(function (r) { r.addEventListener('change', refresh); });

    root.querySelectorAll('[data-pdp-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        if (mainImg) mainImg.src = t.getAttribute('data-src');
        root.querySelectorAll('[data-pdp-thumb]').forEach(function (x) { x.classList.remove('active'); });
        t.classList.add('active');
      });
    });

    root.querySelectorAll('[data-pdp-qty]').forEach(function (b) {
      b.addEventListener('click', function () {
        var d = parseInt(b.getAttribute('data-pdp-qty'), 10);
        qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) + d);
      });
    });

    refresh();
  })();
</script>

{% schema %}
{
  "name": "LBS Product",
  "tag": "section",
  "class": "section-lbs-product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_perks", "label": "Show perks list", "default": true }
  ]
}
{% endschema %}
