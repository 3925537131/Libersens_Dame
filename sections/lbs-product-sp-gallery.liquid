<section class="lbs lbs-sp-gallery">
  <div class="lbs-sp-gallery__grid">

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <article class="lbs-sp-gallery__col" {{ block.shopify_attributes }}>
          <div class="lbs-sp-gallery__img-wrap">
            {%- if block.settings.image != blank -%}
              <img class="lbs-sp-gallery__img"
                src="{{ block.settings.image | image_url: width: 700 }}"
                alt="{{ block.settings.title | escape }}"
                width="700" height="880" loading="lazy">
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg lbs-sp-gallery__placeholder' }}
            {%- endif -%}
          </div>
          <div class="lbs-sp-gallery__label">
            {%- case block.settings.icon -%}
              {%- when 'package' -%}
                <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><rect x="3" y="9" width="24" height="18" rx="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 14h24M11 9V6a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M11 19h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              {%- when 'silicone' -%}
                <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M10 5h10v9l4.5 10A2 2 0 0122.7 27H7.3a2 2 0 01-1.8-2.8L10 14V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 17h10M8 22h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              {%- when 'water' -%}
                <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 4C11 9.5 8 13 8 17a7 7 0 0014 0c0-4-3-7.5-7-13z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 19c.5 2 2 3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              {%- when 'warranty' -%}
                <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 3l10 4v8c0 6.5-4.5 11.5-10 12.5C9.5 26.5 5 21.5 5 15V7l10-4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M11 15l3 3 5.5-5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- else -%}
                <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 4l2.8 8.5H27l-7 5.3 2.7 8.2L15 21l-7.7 5 2.7-8.2-7-5.3h9.2L15 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {%- endcase -%}
            <div class="lbs-sp-gallery__text">
              <p class="lbs-sp-gallery__title">{{ block.settings.title }}</p>
              <p class="lbs-sp-gallery__sub">{{ block.settings.subtitle }}</p>
            </div>
          </div>
        </article>
      {%- endfor -%}

    {%- else -%}
      <!-- Default hardcoded columns (shown when no blocks are configured) -->
      <article class="lbs-sp-gallery__col">
        <div class="lbs-sp-gallery__img-wrap">
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg lbs-sp-gallery__placeholder' }}
        </div>
        <div class="lbs-sp-gallery__label">
          <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><rect x="3" y="9" width="24" height="18" rx="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 14h24M11 9V6a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M11 19h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <div class="lbs-sp-gallery__text">
            <p class="lbs-sp-gallery__title">Discreet Packaging</p>
            <p class="lbs-sp-gallery__sub">Plain box — no brand name visible outside.</p>
          </div>
        </div>
      </article>
      <article class="lbs-sp-gallery__col">
        <div class="lbs-sp-gallery__img-wrap">
          {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg lbs-sp-gallery__placeholder' }}
        </div>
        <div class="lbs-sp-gallery__label">
          <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M10 5h10v9l4.5 10A2 2 0 0122.7 27H7.3a2 2 0 01-1.8-2.8L10 14V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 17h10M8 22h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <div class="lbs-sp-gallery__text">
            <p class="lbs-sp-gallery__title">Medical Grade Silicone</p>
            <p class="lbs-sp-gallery__sub">100% body-safe and hypoallergenic.</p>
          </div>
        </div>
      </article>
      <article class="lbs-sp-gallery__col">
        <div class="lbs-sp-gallery__img-wrap">
          {{ 'product-apparel-3' | placeholder_svg_tag: 'placeholder-svg lbs-sp-gallery__placeholder' }}
        </div>
        <div class="lbs-sp-gallery__label">
          <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 4C11 9.5 8 13 8 17a7 7 0 0014 0c0-4-3-7.5-7-13z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 19c.5 2 2 3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <div class="lbs-sp-gallery__text">
            <p class="lbs-sp-gallery__title">Waterproof Charging Port</p>
            <p class="lbs-sp-gallery__sub">Bath or shower — no worries.</p>
          </div>
        </div>
      </article>
      <article class="lbs-sp-gallery__col">
        <div class="lbs-sp-gallery__img-wrap">
          {{ 'product-apparel-4' | placeholder_svg_tag: 'placeholder-svg lbs-sp-gallery__placeholder' }}
        </div>
        <div class="lbs-sp-gallery__label">
          <svg class="lbs-sp-gallery__icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 3l10 4v8c0 6.5-4.5 11.5-10 12.5C9.5 26.5 5 21.5 5 15V7l10-4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M11 15l3 3 5.5-5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="lbs-sp-gallery__text">
            <p class="lbs-sp-gallery__title">1-Year Warranty</p>
            <p class="lbs-sp-gallery__sub">Full coverage for your peace of mind.</p>
          </div>
        </div>
      </article>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "LBS SP Gallery",
  "tag": "section",
  "class": "section-lbs-sp-gallery",
  "settings": [],
  "blocks": [
    {
      "type": "column",
      "name": "Gallery column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "package",  "label": "Box / Discreet packaging" },
            { "value": "silicone", "label": "Flask / Medical silicone" },
            { "value": "water",    "label": "Drop / Waterproof" },
            { "value": "warranty", "label": "Shield / Warranty" },
            { "value": "star",     "label": "Star (default)" }
          ],
          "default": "star"
        },
        { "type": "text", "id": "title",    "label": "Title",    "default": "Feature title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Short description." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS SP Gallery",
      "blocks": [
        { "type": "column", "settings": { "icon": "package",  "title": "Discreet Packaging",       "subtitle": "Plain box — no brand name visible outside." } },
        { "type": "column", "settings": { "icon": "silicone", "title": "Medical Grade Silicone",    "subtitle": "100% body-safe and hypoallergenic." } },
        { "type": "column", "settings": { "icon": "water",    "title": "Waterproof Charging Port",  "subtitle": "Bath or shower — no worries." } },
        { "type": "column", "settings": { "icon": "warranty", "title": "1-Year Warranty",           "subtitle": "Full coverage for your peace of mind." } }
      ]
    }
  ]
}
{% endschema %}
