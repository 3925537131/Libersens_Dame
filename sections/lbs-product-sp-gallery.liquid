{%- comment -%}
  SP Gallery — ports dame.com's product-sp-gallery web component exactly:
  4-column desktop grid + infinite mobile carousel with pagination dots.
  Default cards use aesthetic brand SVG illustrations; each card's image can be
  overridden by uploading a photo via the block's image picker.
{%- endcomment -%}

{%- comment -%} Default card data (used when no blocks are configured) {%- endcomment -%}
{%- assign d_icons     = 'package,silicone,water,warranty' | split: ',' -%}
{%- assign d_titles    = 'Discreet Packaging|||MEDICAL GRADE SILICONE|||WATERPROOF CHARGING PORT|||3-YEAR WARRANTY' | split: '|||' -%}
{%- assign d_subs      = 'No more — “I was traveling and didn’t want a box left on my porch.”|||No more — “I kept wondering if the material was really safe to use on my body.”|||No more — “I wanted to use it in the shower but wasn’t sure if it was really safe.”|||No more — “I didn’t want to invest in something that might break too soon.”' | split: '|||' -%}
{%- assign d_grad_top  = '#efe9fb,#e3f3ef,#e6ecff,#fdeee6' | split: ',' -%}
{%- assign d_grad_bot  = '#ffffff,#ffffff,#ffffff,#ffffff' | split: ',' -%}
{%- assign d_accent    = '#7a5f80,#2f8f8a,#7a5f80,#e0673f' | split: ',' -%}

<product-sp-gallery id="product-sp-gallery-{{ section.id }}" class="lbs product-sp-gallery" data-section-id="{{ section.id }}" data-mobile-infinite="true">

  {%- comment -%} ===== DESKTOP GRID ===== {%- endcomment -%}
  <div class="product-sp-gallery__desktop" role="list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <article class="product-sp-gallery__item" role="listitem" {{ block.shopify_attributes }}>
          {%- render 'lbs-sp-gallery-card',
              image: block.settings.image, icon: block.settings.icon,
              title: block.settings.title, subtitle: block.settings.subtitle,
              grad_top: block.settings.grad_top, grad_bottom: '#ffffff', accent: block.settings.accent -%}
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (0..3) -%}
        <article class="product-sp-gallery__item" role="listitem">
          {%- render 'lbs-sp-gallery-card',
              image: blank, icon: d_icons[i],
              title: d_titles[i], subtitle: d_subs[i],
              grad_top: d_grad_top[i], grad_bottom: d_grad_bot[i], accent: d_accent[i] -%}
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- comment -%} ===== MOBILE CAROUSEL ===== {%- endcomment -%}
  <div class="product-sp-gallery__mobile">
    <div class="product-sp-gallery__track" data-gallery-track>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="product-sp-gallery__slide">
            {%- render 'lbs-sp-gallery-card',
                image: block.settings.image, icon: block.settings.icon,
                title: block.settings.title, subtitle: block.settings.subtitle,
                grad_top: block.settings.grad_top, grad_bottom: '#ffffff', accent: block.settings.accent -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (0..3) -%}
          <article class="product-sp-gallery__slide">
            {%- render 'lbs-sp-gallery-card',
                image: blank, icon: d_icons[i],
                title: d_titles[i], subtitle: d_subs[i],
                grad_top: d_grad_top[i], grad_bottom: d_grad_bot[i], accent: d_accent[i] -%}
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="product-sp-gallery__dots" role="tablist" aria-label="Gallery pagination">
      {%- if section.blocks.size > 0 -%}{%- assign dot_count = section.blocks.size -%}{%- else -%}{%- assign dot_count = 4 -%}{%- endif -%}
      {%- for i in (1..dot_count) -%}
        <button type="button" class="product-sp-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" role="tab"></button>
      {%- endfor -%}
    </div>
  </div>

</product-sp-gallery>

<style>
#shopify-section-{{ section.id }} { padding-bottom: 60px; }
@media screen and (min-width: 750px) {
  body.template-product #shopify-section-{{ section.id }} { padding-top: 60px; }
}
@media screen and (max-width: 749px) {
  body.template-product #shopify-section-{{ section.id }} { padding-bottom: 0; }
}

#product-sp-gallery-{{ section.id }} {
  --spg-dot: #c4c3f2;
  --spg-dot-active: var(--blue);
  display: block;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__desktop {
  display: flex;
  gap: clamp(20px, 2vw, 40px);
  background-color: var(--cream);
  padding: 32px 24px;
  max-width: 85vw;
  margin: 0 auto;
  border-radius: 20px;
  justify-content: space-evenly;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__mobile {
  display: none;
  background-color: var(--cream);
  border-radius: 12px;
  padding: 20px;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__item,
#product-sp-gallery-{{ section.id }} .product-sp-gallery__slide { text-align: center; flex: 1; min-width: 0; }
#product-sp-gallery-{{ section.id }} .product-sp-gallery__image-wrap {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  margin-bottom: 18px;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__image {
  width: 100%;
  height: 100%;
  max-height: 300px;
  object-fit: contain;
  object-position: center bottom;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__title-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 12px;
  max-width: 100%;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__icon { display: inline-flex; width: 24px; height: 24px; flex-shrink: 0; }
#product-sp-gallery-{{ section.id }} .product-sp-gallery__icon svg { width: 24px; height: 24px; }
#product-sp-gallery-{{ section.id }} .product-sp-gallery__title {
  margin: 0;
  color: var(--blue);
  font-family: var(--sans);
  font-size: 18px;
  font-weight: 600;
  line-height: 1.25;
  text-transform: uppercase;
}
#product-sp-gallery-{{ section.id }} .product-sp-gallery__subtitle {
  color: #333;
  font-family: var(--sans);
  font-size: 16px;
  font-weight: 400;
  line-height: 1.45;
  width: min(100%, 297px);
  max-width: 297px;
  margin-inline: auto;
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} { padding-bottom: 24px; }
  #product-sp-gallery-{{ section.id }} { padding: 0 20px 20px; display: block; }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__desktop { display: none; }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__mobile { display: block; }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__track {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__track::-webkit-scrollbar { display: none; }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__slide { min-width: 100%; scroll-snap-align: start; flex: 0 0 100%; }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__image-wrap { margin-bottom: 16px; }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-top: 20px;
  }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__dot {
    min-width: 8px; height: 8px; max-width: 8px;
    border: 0; border-radius: 999px;
    background: var(--spg-dot);
    cursor: pointer; padding: 0;
    transition: background-color 200ms ease;
  }
  #product-sp-gallery-{{ section.id }} .product-sp-gallery__dot.is-active { background: var(--spg-dot-active); }
}
</style>

<script>
(() => {
  class ProductSpGallery extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-gallery-track]');
      this.dots = Array.from(this.querySelectorAll('[data-gallery-dot]'));
      this.scrollStopTimer = null;
      if (!this.track || this.dots.length < 2) return;

      this.enableInfiniteMobile = this.dataset.mobileInfinite === 'true';
      this.realSlideCount = this.dots.length;
      if (this.enableInfiniteMobile) this.setupInfiniteTrack();

      this.onDotClick = this.handleDotClick.bind(this);
      this.onTrackScrollEnd = this.handleTrackScrollEnd.bind(this);
      this.onTrackScroll = this.handleTrackScroll.bind(this);

      this.dots.forEach((dot) => dot.addEventListener('click', this.onDotClick));
      this.track.addEventListener('scrollend', this.onTrackScrollEnd);
      this.track.addEventListener('scroll', this.onTrackScroll, { passive: true });
    }
    disconnectedCallback() {
      if (!this.track || !this.dots.length) return;
      this.dots.forEach((dot) => dot.removeEventListener('click', this.onDotClick));
      this.track.removeEventListener('scrollend', this.onTrackScrollEnd);
      this.track.removeEventListener('scroll', this.onTrackScroll);
      if (this.scrollStopTimer) { window.clearTimeout(this.scrollStopTimer); this.scrollStopTimer = null; }
    }
    handleDotClick(event) {
      const index = Number.parseInt(event.currentTarget.dataset.galleryDot, 10);
      if (Number.isNaN(index)) return;
      this.scrollToSlide(index);
    }
    handleTrackScroll() {
      this.updateActiveDot();
      if (this.scrollStopTimer) window.clearTimeout(this.scrollStopTimer);
      this.scrollStopTimer = window.setTimeout(() => this.handleTrackScrollEnd(), 120);
    }
    handleTrackScrollEnd() {
      if (this.enableInfiniteMobile) this.correctLoopPosition();
      this.updateActiveDot();
    }
    scrollToSlide(index) {
      const slideWidth = this.track.clientWidth;
      const targetVirtualIndex = this.enableInfiniteMobile ? index + 1 : index;
      this.track.scrollTo({ left: slideWidth * targetVirtualIndex, behavior: 'smooth' });
    }
    updateActiveDot() {
      const slideWidth = this.track.clientWidth || 1;
      const virtualIndex = Math.round(this.track.scrollLeft / slideWidth);
      const index = this.enableInfiniteMobile ? this.getRealIndexFromVirtual(virtualIndex) : virtualIndex;
      this.dots.forEach((dot, dotIndex) => {
        const active = dotIndex === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }
    setupInfiniteTrack() {
      const slides = Array.from(this.track.querySelectorAll('.product-sp-gallery__slide'));
      if (slides.length < 2) return;
      const firstClone = slides[0].cloneNode(true);
      const lastClone = slides[slides.length - 1].cloneNode(true);
      firstClone.setAttribute('data-gallery-clone', 'true');
      lastClone.setAttribute('data-gallery-clone', 'true');
      this.track.insertBefore(lastClone, slides[0]);
      this.track.appendChild(firstClone);
      requestAnimationFrame(() => {
        const slideWidth = this.track.clientWidth || 1;
        this.track.scrollTo({ left: slideWidth, behavior: 'auto' });
      });
    }
    correctLoopPosition() {
      const slideWidth = this.track.clientWidth || 1;
      const virtualIndex = Math.round(this.track.scrollLeft / slideWidth);
      if (virtualIndex === 0) { this.track.scrollTo({ left: slideWidth * this.realSlideCount, behavior: 'auto' }); return; }
      if (virtualIndex === this.realSlideCount + 1) { this.track.scrollTo({ left: slideWidth, behavior: 'auto' }); }
    }
    getRealIndexFromVirtual(virtualIndex) {
      return (virtualIndex - 1 + this.realSlideCount) % this.realSlideCount;
    }
  }
  if (!customElements.get('product-sp-gallery')) {
    customElements.define('product-sp-gallery', ProductSpGallery);
  }
})();
</script>

{% schema %}
{
  "name": "LBS SP Gallery",
  "tag": "section",
  "class": "section-lbs-sp-gallery",
  "settings": [],
  "blocks": [
    {
      "type": "column",
      "name": "Gallery column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (overrides illustration)" },
        {
          "type": "select", "id": "icon", "label": "Icon / illustration",
          "options": [
            { "value": "package",  "label": "Box / Packaging" },
            { "value": "silicone", "label": "Drop / Silicone" },
            { "value": "water",    "label": "Drop / Waterproof" },
            { "value": "warranty", "label": "Shield / Warranty" }
          ],
          "default": "package"
        },
        { "type": "color", "id": "grad_top", "label": "Illustration background", "default": "#efe9fb" },
        { "type": "color", "id": "accent",   "label": "Illustration accent",     "default": "#7a5f80" },
        { "type": "text",     "id": "title",    "label": "Title",    "default": "Discreet Packaging" },
        { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "No more — “…”" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS SP Gallery",
      "blocks": [
        { "type": "column", "settings": { "icon": "package",  "grad_top": "#efe9fb", "accent": "#7a5f80", "title": "Discreet Packaging",        "subtitle": "No more — “I was traveling and didn’t want a box left on my porch.”" } },
        { "type": "column", "settings": { "icon": "silicone", "grad_top": "#e3f3ef", "accent": "#2f8f8a", "title": "MEDICAL GRADE SILICONE",     "subtitle": "No more — “I kept wondering if the material was really safe to use on my body.”" } },
        { "type": "column", "settings": { "icon": "water",    "grad_top": "#e6ecff", "accent": "#7a5f80", "title": "WATERPROOF CHARGING PORT",   "subtitle": "No more — “I wanted to use it in the shower but wasn’t sure if it was really safe.”" } },
        { "type": "column", "settings": { "icon": "warranty", "grad_top": "#fdeee6", "accent": "#e0673f", "title": "3-YEAR WARRANTY",            "subtitle": "No more — “I didn’t want to invest in something that might break too soon.”" } }
      ]
    }
  ]
}
{% endschema %}
