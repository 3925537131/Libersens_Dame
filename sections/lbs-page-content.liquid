<div class="lbs lbs-page-content">
  <div class="wrap">

    <header class="lbs-page-content__header">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.title | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="lbs-page-content__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- if page.content != blank or section.settings.body != blank -%}
      <div class="lbs-page-content__body rte">
        {{ page.content }}
        {{ section.settings.body }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="lbs-page-content__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="lbs-page-content__card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="lbs-page-content__card-icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              <h3>{{ block.settings.heading }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
              {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" class="btn btn--outline">{{ block.settings.link_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "LBS Page content",
  "tag": "section",
  "class": "section-lbs-page-content",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "title", "label": "Page title override", "info": "Defaults to the Shopify page title if blank." },
    { "type": "textarea", "id": "intro", "label": "Intro / lead text" },
    { "type": "richtext", "id": "body", "label": "Body content override", "info": "If set, this replaces the page's native body content." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Info card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)" },
        { "type": "text", "id": "heading", "label": "Card heading", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Card text", "default": "<p>Description of this feature or section.</p>" },
        { "type": "text", "id": "link_label", "label": "Button label" },
        { "type": "url", "id": "link_url", "label": "Button URL" }
      ]
    }
  ],
  "presets": [{ "name": "LBS Page content" }]
}
{% endschema %}
