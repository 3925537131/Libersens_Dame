<header class="site-header">
  {% if section.settings.announcement_text != blank %}
    <a class="announcement-bar" href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}">
      {{ section.settings.announcement_text }}
    </a>
  {% endif %}

  <div class="container">
    <div class="header-inner">
      <a class="brand-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% if settings.logo != blank %}
          <img class="brand-logo" src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="160" height="60">
        {% else %}
          {{ settings.brand_name | default: 'libersens' }}
        {% endif %}
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <div class="nav-item nav-item--dropdown">
          <a class="nav-link" href="/collections/she-bell" aria-haspopup="true">She Bell</a>
          <div class="nav-dropdown" role="menu" aria-label="She Bell">
            <a href="/products/she-bell-2" role="menuitem">
              <span>She Bell</span>
              <small>The signature soft-touch essential</small>
            </a>
            <a href="/products/she-bell-1" role="menuitem">
              <span>She Bell 2</span>
              <small>Sculpted form, gentle modes</small>
            </a>
            <a href="/products/she-bell" role="menuitem">
              <span>She Bell 3</span>
              <small>Deeper modes, refined controls</small>
            </a>
            <a href="/products/she-bell-4" role="menuitem">
              <span>She Bell 4</span>
              <small>Deeper modes, refined controls</small>
            </a>
            <a href="/products/she-bell-5" role="menuitem">
              <span>She Bell 5</span>
              <small>Deeper modes, refined controls</small>
            </a>
          </div>
        </div>
        <div class="nav-item nav-item--dropdown">
          <a class="nav-link" href="/collections/aura" aria-haspopup="true">Aura</a>
          <div class="nav-dropdown" role="menu" aria-label="Aura">
            <a href="/products/aura" role="menuitem">
              <span>Aura</span>
              <small>Discreet, hands-free comfort</small>
            </a>
            <a href="/products/aura-2" role="menuitem">
              <span>Aura 1</span>
              <small>Designed for shared connection</small>
            </a>
            <a href="/products/aura-3" role="menuitem">
              <span>Aura 2</span>
              <small>App and remote control</small>
            </a>
          </div>
        </div>
        <a class="nav-link" href="/products/petite">Petite</a>
        <a class="nav-link" href="/collections/best-sellers">Best sellers</a>
        <a class="nav-link" href="/collections/accessories">Accessories</a>
        <div class="nav-item nav-item--dropdown">
          <a class="nav-link" href="/pages/user-guide" aria-haspopup="true">User guide</a>
          <div class="nav-dropdown" role="menu" aria-label="User guide">
            <a href="/pages/user-guide" role="menuitem">
              <span>Care guide</span>
              <small>Cleaning, charging, and storage</small>
            </a>
            <a href="/pages/faq" role="menuitem">
              <span>FAQ</span>
              <small>Shipping, privacy, and returns</small>
            </a>
            <a href="/pages/about-us" role="menuitem">
              <span>About us</span>
              <small>Our approach to intimacy care</small>
            </a>
          </div>
        </div>
      </nav>

      <div class="header-actions">
        <button class="header-icon" type="button" data-search-open aria-label="Search">
          {% render 'icon', icon: 'search' %}
        </button>
        <a class="header-icon" href="{{ routes.account_login_url | default: '/account' }}" aria-label="Account">
          {% render 'icon', icon: 'account' %}
        </a>
        <a class="header-icon" href="{{ routes.cart_url }}" data-cart-open aria-label="Cart ({{ cart.item_count }} items)">
          {% render 'icon', icon: 'cart' %}
          <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
        </a>
      </div>

      <button class="header-icon mobile-menu-btn" type="button" data-mobile-menu-open aria-label="Open navigation" aria-expanded="false" aria-controls="MobileMenuDrawer">
        {% render 'icon', icon: 'menu' %}
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile menu — full-height side drawer (slides in from right) {%- endcomment -%}
<div id="MobileMenuDrawer" class="mobile-menu-drawer" aria-hidden="true">
  <div class="mobile-menu-drawer__backdrop" data-mobile-menu-close></div>
  <nav class="mobile-menu-panel" aria-label="Mobile navigation">

    <div class="mobile-menu-panel__head">
      <span class="mobile-menu-panel__title">Menu</span>
      <button class="mobile-menu-panel__close" type="button" data-mobile-menu-close aria-label="Close navigation">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 3L17 17M17 3L3 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="mobile-menu-panel__scroll">
      <a href="/collections/she-bell" class="mobile-menu-panel__link mobile-menu-panel__link--parent">She Bell</a>
      <a href="/products/she-bell-2" class="mobile-menu-panel__link mobile-menu-panel__link--child">She Bell</a>
      <a href="/products/she-bell-1" class="mobile-menu-panel__link mobile-menu-panel__link--child">She Bell 2</a>
      <a href="/products/she-bell" class="mobile-menu-panel__link mobile-menu-panel__link--child">She Bell 3</a>
      <a href="/products/she-bell-4" class="mobile-menu-panel__link mobile-menu-panel__link--child">She Bell 4</a>
      <a href="/products/she-bell-5" class="mobile-menu-panel__link mobile-menu-panel__link--child">She Bell 5</a>
      <a href="/collections/aura" class="mobile-menu-panel__link mobile-menu-panel__link--parent">Aura</a>
      <a href="/products/aura" class="mobile-menu-panel__link mobile-menu-panel__link--child">Aura</a>
      <a href="/products/aura-2" class="mobile-menu-panel__link mobile-menu-panel__link--child">Aura 1</a>
      <a href="/products/aura-3" class="mobile-menu-panel__link mobile-menu-panel__link--child">Aura 2</a>
      <a href="/products/petite" class="mobile-menu-panel__link mobile-menu-panel__link--parent">Petite</a>
      <a href="/collections/best-sellers" class="mobile-menu-panel__link mobile-menu-panel__link--parent">Best sellers</a>
      <a href="/collections/accessories" class="mobile-menu-panel__link mobile-menu-panel__link--parent">Accessories</a>
      <a href="/pages/user-guide" class="mobile-menu-panel__link mobile-menu-panel__link--parent">User guide</a>
      <a href="/pages/user-guide" class="mobile-menu-panel__link mobile-menu-panel__link--child">Care guide</a>
      <a href="/pages/faq" class="mobile-menu-panel__link mobile-menu-panel__link--child">FAQ</a>
      <a href="/pages/about-us" class="mobile-menu-panel__link mobile-menu-panel__link--child">About us</a>
      <a href="/pages/contact" class="mobile-menu-panel__link mobile-menu-panel__link--parent">Contact</a>
    </div>

  </nav>
</div>

{% render 'search-panel' %}
{% render 'cart-drawer' %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Discreet shipping on every Libersens order"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    }
  ]
}
{% endschema %}
