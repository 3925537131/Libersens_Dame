<section class="lbs story" id="{{ section.settings.anchor_id | default: 'story' }}">
  <div class="story__img"{% if section.settings.image %} style="background-image:url('{{ section.settings.image | image_url: width: 1600 }}');background-size:cover;background-position:center"{% endif %}></div>
  <div class="story__copy">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary" style="margin-top:8px">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LBS Brand story",
  "tag": "section",
  "class": "section-lbs-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built by women who were tired of being an afterthought." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Libersens was founded by a sexologist and a product engineer with one shared frustration: intimate products designed without women in the room. So we built our own — researched with real bodies, tested in our own labs, and refined by thousands of women like you.</p><p>Every Libersens product is body-safe, beautifully made, and engineered to help close the pleasure gap for good.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "story" }
  ],
  "presets": [{ "name": "LBS Brand story" }]
}
{% endschema %}
