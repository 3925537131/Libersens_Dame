            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

</div>

<script>
(function () {
  /* Filter toggle */
  var wrap = document.getElementById('lbsFilterWrap');
  var btn  = document.getElementById('lbsFilterToggle');
  var drop = document.getElementById('lbsFilterDropdown');
  if (btn && drop) {
    btn.addEventListener('click', function () {
      var open = wrap.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open);
    });
    document.addEventListener('click', function (e) {
      if (!wrap.contains(e.target)) wrap.classList.remove('is-open');
    });
    /* Set label from active filter */
    var active = drop.querySelector('.lbs-coll-dame__filter-opt.is-active');
    if (active) {
      var label = active.textContent.trim();
      if (label !== 'Shop All') document.getElementById('lbsFilterLabel').textContent = label;
    }
  }
  /* Sort by URL */
  var sel = document.querySelector('[data-coll-sort]');
  if (sel) {
    sel.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', sel.value);
      url.searchParams.delete('page');
      window.location.href = url.toString();
    });
  }
})();
})();
</script>

<script>
(function () {
  /* Guide expand */
  var guide = document.getElementById('lbsGuide');
  var content = document.getElementById('lbsGuideContent');
  var btn = document.getElementById('lbsGuideToggle');
  if (guide && content && btn) {
    var MOBILE = 200, DESKTOP = 300;
    function maxH() { return window.innerWidth >= 750 ? DESKTOP : MOBILE; }
    function checkGuide() {
      if (content.scrollHeight <= maxH() + 1) { btn.hidden = true; content.style.maxHeight = ''; return; }
      btn.hidden = false;
      if (guide.dataset.expanded !== 'true') content.style.maxHeight = maxH() + 'px';
    }
    btn.addEventListener('click', function () {
      if (guide.dataset.expanded === 'true') {
        content.style.maxHeight = content.scrollHeight + 'px';
        content.offsetHeight;
        content.style.maxHeight = maxH() + 'px';
        guide.dataset.expanded = 'false';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        guide.dataset.expanded = 'true';
        btn.setAttribute('aria-expanded', 'true');
        content.addEventListener('transitionend', function h(e) {
          if (e.target === content && e.propertyName === 'max-height') {
            content.style.maxHeight = 'none';
            content.removeEventListener('transitionend', h);
          }
        });
      }
    });
    window.addEventListener('resize', checkGuide);
    checkGuide();
  }

  /* FAQ accordion */
  var faq = document.getElementById('lbsCollFaq');
  if (faq) {
    faq.addEventListener('click', function (e) {
      var b = e.target.closest('.lbs-coll-dame__faq-q button');
      if (!b) return;
      var item = b.closest('.lbs-coll-dame__faq-item');
      var open = item.getAttribute('data-open') === 'true';
      item.setAttribute('data-open', open ? 'false' : 'true');
      b.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  }
})();
</script>

{% schema %}
{
  "name": "LBS Collection",
  "tag": "section",
  "class": "section-lbs-collection",
  "settings": [
    { "type": "header", "content": "Hero banner" },
    { "type": "image_picker", "id": "banner_image", "label": "Desktop banner image" },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Mobile banner image (optional)" },
    { "type": "text", "id": "heading", "label": "Banner heading", "info": "Defaults to collection title." },
    { "type": "text", "id": "banner_subtitle", "label": "Banner subtitle" },
    { "type": "text", "id": "caption_product", "label": "Featured product name (pill)", "info": "Shows a caption pill at bottom-right of banner, e.g. \"Eva\"." },
    { "type": "text", "id": "caption_label", "label": "Caption pill subtitle", "default": "Wearable Couples Vibe" },
    { "type": "header", "content": "Collection" },
    { "type": "richtext", "id": "description", "label": "Collection description override", "info": "Defaults to Shopify collection description." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 16 },
    { "type": "header", "content": "Guide section (expandable)" },
    { "type": "text", "id": "guide_heading", "label": "Heading" },
    { "type": "richtext", "id": "guide_body", "label": "Body text", "info": "Leave blank to hide this section." },
    { "type": "header", "content": "About section + FAQ" },
    { "type": "text", "id": "about_heading", "label": "Heading" },
    { "type": "richtext", "id": "about_body", "label": "About body text", "info": "Leave blank to hide this section." }
  ],
  "blocks": [
    {
      "type": "filter_tag",
      "name": "Filter tag",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Solo Toys" },
        { "type": "text", "id": "tag_handle", "label": "Tag handle", "info": "Must match Shopify product tag exactly (lowercase, hyphenated).", "default": "solo" }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Collection",
      "blocks": [
        { "type": "filter_tag", "settings": { "label": "Solo Toys", "tag_handle": "solo" } },
        { "type": "filter_tag", "settings": { "label": "Couple's Toys", "tag_handle": "couples" } },
        { "type": "filter_tag", "settings": { "label": "Internal Vibes", "tag_handle": "internal" } },
        { "type": "filter_tag", "settings": { "label": "External Vibes", "tag_handle": "external" } },
        { "type": "filter_tag", "settings": { "label": "Under $100", "tag_handle": "under-100" } }
      ]
    }
  ]
}
{% endschema %}
