                <h3 class="lbs-coll-dame__faq-q">
                  <button type="button" aria-expanded="false" aria-controls="lbs-faq-{{ block.id }}">{{ block.settings.question }}</button>
                </h3>
                <div id="lbs-faq-{{ block.id }}" class="lbs-coll-dame__faq-a-wrap" role="region">
                  <div class="lbs-coll-dame__faq-a">{{ block.settings.answer }}</div>
