<section class="lbs coll-section">
  <div class="coll-banner">
    <div class="wrap">
      <h1>{{ collection.title | default: 'All products' }}</h1>
      {%- if collection.description != blank -%}
        <div class="coll-banner__desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="wrap">
    <div class="coll-toolbar">
      <span class="coll-count">{{ collection.products_count }} products</span>
      {%- if section.settings.enable_sorting -%}
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <div class="coll-sort">
          <label for="coll-sort-{{ section.id }}">Sort by</label>
          <select id="coll-sort-{{ section.id }}" data-coll-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="col-grid" style="--cols:{{ section.settings.columns_desktop }}">
        {%- for product in collection.products -%}
          {%- render 'lbs-product-card', product: product -%}
        {%- else -%}
          <p class="coll-empty">No products found in this collection yet.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="coll-pagination" role="navigation" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="coll-page" href="{{ paginate.previous.url }}" aria-label="Previous">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="coll-page" href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="coll-page coll-page--current">{{ part.title }}</span>
            {%- else -%}
              <span class="coll-page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a class="coll-page" href="{{ paginate.next.url }}" aria-label="Next">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<script>
  (function () {
    var sel = document.querySelector('[data-coll-sort]');
    if (!sel) return;
    sel.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', sel.value);
      url.searchParams.delete('page');
      window.location.href = url.toString();
    });
  })();
</script>

{% schema %}
{
  "name": "LBS Collection",
  "tag": "section",
  "class": "section-lbs-collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 16 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ]
}
{% endschema %}
