{%- paginate blog.articles by 9 -%}
<div class="lbs lbs-blog-index">

  <div class="lbs-blog-index__head2">
    <h1 class="lbs-blog-index__h2title">{{ section.settings.heading | default: blog.title | default: 'Journal' }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="lbs-blog-index__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <div class="wrap lbs-blog-index__wrap">
    {%- if blog.articles_count > 0 -%}

      <div class="lbs-blog-grid">
        {%- assign bgs = 'var(--lavender),var(--peach),var(--mint),var(--lime)' | split: ',' -%}
        {%- for article in blog.articles -%}
          {%- assign ci = forloop.index0 | modulo: bgs.size -%}
          <article class="lbs-bcard">
            <a href="{{ article.url }}" class="lbs-bcard__img" style="background:{{ bgs[ci] | strip }}">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy">
              {%- endif -%}
            </a>
            {%- if article.tags.size > 0 -%}<span class="lbs-bcard__tag">{{ article.tags.first }}</span>{%- endif -%}
            <h2 class="lbs-bcard__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <time class="lbs-bcard__date">{{ article.published_at | date: '%B %d, %Y' }}</time>
            <p class="lbs-bcard__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            {%- if article.comments_count and article.comments_count > 0 -%}
              <span class="lbs-bcard__comments">{{ article.comments_count }} comment{% if article.comments_count != 1 %}s{% endif %}</span>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="lbs-blog-index__pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn--outline">← Newer</a>
          {%- endif -%}
          <span class="lbs-blog-index__page-count">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn--outline">Older →</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <p class="lbs-blog-index__empty">No posts yet — check back soon.</p>
    {%- endif -%}
  </div>

</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "LBS Blog index",
  "tag": "section",
  "class": "section-lbs-blog-index",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Libersens Journal" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Defaults to blog title if blank." },
    { "type": "textarea", "id": "intro", "label": "Intro text" }
  ],
  "presets": [{ "name": "LBS Blog index" }]
}
{% endschema %}
