{%- paginate blog.articles by 9 -%}
<div class="lbs lbs-blog-index">

  <div class="lbs-blog-index__header">
    <div class="wrap">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Libersens Journal' }}</span>
      <h1>{{ section.settings.heading | default: blog.title | default: 'Learn &amp; Explore' }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="lbs-blog-index__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="wrap lbs-blog-index__wrap">
    {%- if blog.articles_count > 0 -%}

      {%- assign featured = blog.articles.first -%}
      {%- if paginate.current_page == 1 -%}
        <div class="lbs-blog-index__featured">
          <a href="{{ featured.url }}" class="lbs-blog-index__featured-img">
            {%- if featured.image -%}
              <img src="{{ featured.image | image_url: width: 1200 }}"
                   alt="{{ featured.image.alt | default: featured.title | escape }}"
                   loading="eager">
            {%- else -%}
              <div style="background:var(--peach);width:100%;height:100%"></div>
            {%- endif -%}
          </a>
          <div class="lbs-blog-index__featured-copy">
            {%- if featured.tags.size > 0 -%}
              <span class="tag">{{ featured.tags.first }}</span>
            {%- endif -%}
            <h2><a href="{{ featured.url }}">{{ featured.title }}</a></h2>
            <p>{{ featured.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
            <a href="{{ featured.url }}" class="btn btn--outline">Read article</a>
          </div>
        </div>
      {%- endif -%}

      <div class="blogs">
        {%- assign bgs = 'var(--lavender),var(--peach),var(--mint),var(--lime)' | split: ',' -%}
        {%- for article in blog.articles -%}
          {%- if paginate.current_page == 1 and forloop.first -%}{%- continue -%}{%- endif -%}
          {%- assign ci = forloop.index0 | modulo: bgs.size -%}
          <article class="post">
            <a href="{{ article.url }}">
              <div class="post__img" style="background:{{ bgs[ci] | strip }}">
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 800 }}"
                       alt="{{ article.image.alt | escape }}" loading="lazy">
                {%- endif -%}
              </div>
            </a>
            {%- if article.tags.size > 0 -%}<span class="tag">{{ article.tags.first }}</span>{%- endif -%}
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
            <a href="{{ article.url }}" class="read">Read more →</a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="lbs-blog-index__pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn--outline">← Newer</a>
          {%- endif -%}
          <span class="lbs-blog-index__page-count">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn--outline">Older →</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      <p class="lbs-blog-index__empty">No posts yet — check back soon.</p>
    {%- endif -%}
  </div>

</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "LBS Blog index",
  "tag": "section",
  "class": "section-lbs-blog-index",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Libersens Journal" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Defaults to blog title if blank." },
    { "type": "textarea", "id": "intro", "label": "Intro text" }
  ],
  "presets": [{ "name": "LBS Blog index" }]
}
{% endschema %}
