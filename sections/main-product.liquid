{% comment %} ── Product story content, auto-generated per product ── {% endcomment %}
{%- if product.handle contains 'she-bell' -%}
  {%- assign story_h1 = 'Designed for your body' -%}
  {%- assign story_p1 = 'She Bell is shaped from body-safe silicone with a whisper-quiet motor — discreet enough for any moment, powerful enough to matter. Its contoured form sits naturally, moving with you throughout the day without adjustment.' -%}
  {%- assign story_h2 = 'Made to be worn, not held' -%}
  {%- assign story_p2 = 'Hands-free and feather-light, She Bell was designed for real life. Three intensity levels, one intuitive press. Wear it during quiet evenings at home or stolen moments away — it keeps pace with you.' -%}
  {%- assign story_h3 = 'Discreet from first touch to last' -%}
  {%- assign story_p3 = 'Every She Bell ships in plain, unmarked packaging. The magnetic charging cable looks like any other accessory on your desk. A soft storage pouch is included so it stays protected between use.' -%}
{%- elsif product.handle == 'petite' -%}
  {%- assign story_h1 = 'Small. Precise. Purposeful.' -%}
  {%- assign story_p1 = 'Petite was built for those who appreciate precision over size. A compact silhouette that fits in the palm of your hand — discreet to carry, effortless to use, and beautifully quiet in any setting.' -%}
  {%- assign story_h2 = 'Travel-ready by design' -%}
  {%- assign story_p2 = 'At under 90g with a magnetic charging cap, Petite slips into any bag without a second thought. A built-in travel lock keeps it safe on the move. No cases, no clutter — just clean simplicity.' -%}
  {%- assign story_h3 = 'Soft enough for every single day' -%}
  {%- assign story_p3 = 'Ultra-soft medical-grade silicone. An easy-clean surface. A finish that stays smooth wash after wash. Petite is the kind of product you stop thinking about — and start simply enjoying.' -%}
{%- elsif product.handle contains 'aura' -%}
  {%- assign story_h1 = 'Connection, redefined' -%}
  {%- assign story_p1 = 'Aura was designed for shared experience. Whether near or far, its app-enabled control means intimacy is no longer tied to the same room — or even the same city. A new kind of closeness.' -%}
  {%- assign story_h2 = 'Technology that disappears' -%}
  {%- assign story_p2 = 'Pair once, forget the setup. The Libersens app connects in seconds and stays connected quietly in the background. Eleven intensity modes, four patterns — all at your fingertips without interrupting the moment.' -%}
  {%- assign story_h3 = 'Soft on skin, kind to the planet' -%}
  {%- assign story_p3 = 'Aura uses 100% body-safe platinum silicone — non-porous, hypoallergenic, and free from phthalates. Rechargeable via USB-C with a full charge lasting up to three hours of use.' -%}
{%- else -%}
  {%- assign story_h1 = 'Crafted with intention' -%}
  {%- assign story_p1 = 'Every Libersens product begins with a single question: what does softness actually feel like? The answer shapes every curve, every mode, and every material choice we make — from first sketch to final finish.' -%}
  {%- assign story_h2 = 'Built for real life' -%}
  {%- assign story_p2 = 'Quiet motors. Body-safe silicone. Intuitive controls. No complicated setups, no noise. Just a product that works as naturally as you do — and fits seamlessly into how you already live.' -%}
  {%- assign story_h3 = 'Privacy in every detail' -%}
  {%- assign story_p3 = 'Discreet packaging, plain charging cables, and a support team that understands some questions are private ones. What you order from Libersens stays between you and your doorstep.' -%}
{%- endif -%}

<section class="section main-product-section">
  <div class="container">
    {% if product != blank %}
      {% assign current_variant = product.selected_or_first_available_variant %}
      <div class="product-page">
        <div class="product-gallery">
          {% if product.media.size > 1 %}
            <div class="product-thumbs">
              {% for media in product.media limit: 9 %}
                {% assign preview_image = media.preview_image %}
                {% if preview_image == blank and media.media_type == 'image' %}
                  {% assign preview_image = media %}
                {% endif %}
                <button type="button" class="product-thumb{% if forloop.first %} is-active{% endif %}" aria-label="View {{ media.alt | default: product.title | escape }}">
                  {% if preview_image != blank %}
                    <img
                      data-gallery-thumb
                      data-gallery-full="{{ preview_image | image_url: width: 2000 }}"
                      src="{{ preview_image | image_url: width: 240 }}"
                      alt="{{ media.alt | default: product.title | escape }}"
                      width="240"
                      height="240"
                    >
                  {% endif %}
                </button>
              {% endfor %}
            </div>
          {% endif %}

          <div class="product-gallery__main">
            {% if product.featured_image != blank %}
              <img
                data-gallery-main
                data-full-src="{{ product.featured_image | image_url: width: 2000 }}"
                src="{{ product.featured_image | image_url: width: 1400 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="1400"
                height="1400"
              >
            {% else %}
              <img
                data-gallery-main
                data-full-src="{{ 'libersens-product-line.png' | asset_url }}"
                src="{{ 'libersens-product-line.png' | asset_url }}"
                alt="{{ product.title | escape }}"
                width="1200"
                height="1200"
              >
            {% endif %}
            <button class="product-zoom-btn" data-product-zoom aria-label="View full size image">
              {% render 'icon', icon: 'search' %}
            </button>
          </div>
        </div>

        <div class="product-info">
          <h1 class="product-info__title">{{ product.title }}</h1>
          <div class="price product-info__price">
            {{ current_variant.price | money }}
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="compare-price">{{ current_variant.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <hr class="product-info__divider">

          {% form 'product', product, class: 'product-form' %}
            {% unless product.has_only_default_variant %}
              <div class="field product-info__options">
                <label for="ProductVariant-{{ section.id }}">Options</label>
                <select id="ProductVariant-{{ section.id }}" name="id">
                  {% for variant in product.variants %}
                    <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                      {{ variant.title }} - {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% else %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% endunless %}

            <div class="product-info__quantity">
              <label for="Quantity-{{ section.id }}">Quantity:</label>
              <div class="quantity-selector" data-quantity-selector>
                <button type="button" class="quantity-selector__btn" data-quantity-minus aria-label="Decrease quantity">
                  {% render 'icon', icon: 'minus' %}
                </button>
                <input class="quantity-input" id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" data-quantity-input>
                <button type="button" class="quantity-selector__btn" data-quantity-plus aria-label="Increase quantity">
                  {% render 'icon', icon: 'plus' %}
                </button>
              </div>
            </div>

            <button class="button button--full product-info__add" type="submit" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}Add to cart{% else %}Sold out{% endif %}
            </button>

            {{ form | payment_button }}
          {% endform %}

          {% assign share_url = product.url | prepend: shop.url %}
          {% assign share_text = product.title | url_encode %}
          <div class="product-share">
            <span class="product-share__label">Share</span>
            <a class="product-share__link" href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">{% render 'icon', icon: 'facebook' %}</a>
            <a class="product-share__link" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ product.featured_image | image_url: width: 1200 | url_encode }}&description={{ share_text }}" target="_blank" rel="noopener" aria-label="Pin on Pinterest">{% render 'icon', icon: 'pinterest' %}</a>
            <a class="product-share__link" href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ share_text }}" target="_blank" rel="noopener" aria-label="Share on X">{% render 'icon', icon: 'twitter' %}</a>
            <a class="product-share__link" href="https://t.me/share/url?url={{ share_url | url_encode }}&text={{ share_text }}" target="_blank" rel="noopener" aria-label="Share on Telegram">{% render 'icon', icon: 'telegram' %}</a>
          </div>

          {% if product.description != blank %}
            <div class="rte product-info__description">{{ product.description }}</div>
          {% endif %}
        </div>
      </div>

      {%- comment -%} Lightbox {%- endcomment -%}
      <div class="product-lightbox" data-product-lightbox hidden>
        <div class="product-lightbox__backdrop" data-lightbox-close></div>
        <div class="product-lightbox__content">
          <button class="product-lightbox__close" data-lightbox-close aria-label="Close image viewer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </button>
          <img class="product-lightbox__img" data-lightbox-img src="" alt="">
        </div>
      </div>

    {% else %}
      <div class="empty-state">
        <h1>Product unavailable</h1>
        <p>This product is not available right now.</p>
      </div>
    {% endif %}
  </div>
</section>

{% if product != blank %}

  {%- comment -%} ── Product Story Section ── {%- endcomment -%}
  <section class="product-story-section">
    <div class="product-story__block">
      <div class="product-story__media">
        <img src="{{ 'libersens-lifestyle.png' | asset_url }}" alt="{{ story_h1 }}" loading="lazy" width="900" height="900">
      </div>
      <div class="product-story__content">
        <h2>{{ story_h1 }}</h2>
        <p>{{ story_p1 }}</p>
      </div>
    </div>

    <div class="product-story__block product-story__block--reverse">
      <div class="product-story__media">
        <img src="{{ 'libersens-product-wearable.png' | asset_url }}" alt="{{ story_h2 }}" loading="lazy" width="900" height="900">
      </div>
      <div class="product-story__content">
        <h2>{{ story_h2 }}</h2>
        <p>{{ story_p2 }}</p>
      </div>
    </div>

    <div class="product-story__highlight">
      <h2>{{ story_h3 }}</h2>
      <p>{{ story_p3 }}</p>
    </div>
  </section>

  {%- comment -%} ── Customer Reviews — Judge.me widget ── {%- endcomment -%}
  <section class="section section--compact product-reviews-section">
    <div class="container">

      {%- comment -%}
        Pre-define the jdgm global BEFORE Judge.me's inline data script runs.
        Without this, "jdgm.data ||= {}" throws ReferenceError because jdgm
        doesn't exist yet (their main JS loads async/defer).
      {%- endcomment -%}
      <script>window.jdgm = window.jdgm || {};</script>

      <!-- Start of Judge.me code -->
      {%- assign has_legacy = false -%}
      {%- if product.metafields.judgeme.widget.size > 20 -%}{%- assign has_legacy = true -%}{%- endif -%}
      <div style="clear:both"></div>
      <div id="judgeme_product_reviews"
           class="jdgm-widget jdgm-review-widget"
           data-product-title="{{ product.title | escape }}"
           data-id="{{ product.id }}"
           data-product-id="{{ product.id }}"
           data-widget="review"
           data-auto-install="false"
           data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
           data-entry-point="review_widget.js"
           data-entry-key="review-widget/main.js">
        {%- if has_legacy -%}
          <div class="jdgm-legacy-widget-content" style="display:none;">{{ product.metafields.judgeme.widget }}</div>
        {%- endif -%}
      </div>
      {%- if product.metafields.judgeme.review_widget_data -%}
        <script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>
      {%- endif -%}
      <!-- End of Judge.me code -->

    </div>
  </section>

  {%- comment -%} ── You May Also Like ── {%- endcomment -%}
  {%- assign rp1 = section.settings.related_product_1 -%}
  {%- assign rp2 = section.settings.related_product_2 -%}
  {%- assign rp3 = section.settings.related_product_3 -%}
  {%- assign rp4 = section.settings.related_product_4 -%}
  {%- assign has_manual = false -%}
  {%- if rp1 != blank or rp2 != blank or rp3 != blank or rp4 != blank -%}{%- assign has_manual = true -%}{%- endif -%}

  <section class="section section--compact related-products-section">
    <div class="container">
      <div class="section-heading content-box--text-center" style="margin-bottom:28px;">
        <h2>You May Also Like</h2>
      </div>
      <div class="product-grid">
        {% if has_manual %}
          {% if rp1 != blank %}{% render 'product-card', product: rp1 %}{% endif %}
          {% if rp2 != blank %}{% render 'product-card', product: rp2 %}{% endif %}
          {% if rp3 != blank %}{% render 'product-card', product: rp3 %}{% endif %}
          {% if rp4 != blank %}{% render 'product-card', product: rp4 %}{% endif %}
        {% else %}
          {%- assign default_handles = 'she-bell-2,petite,aura,she-bell' | split: ',' -%}
          {%- assign shown = 0 -%}
          {%- for handle in default_handles -%}
            {%- assign rp = all_products[handle] -%}
            {%- if rp.id != blank and rp.id != product.id and shown < 4 -%}
              {% render 'product-card', product: rp %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {% endif %}
      </div>
    </div>
  </section>

{% endif %}

{%- comment -%}
  ── Review toast & float bar ────────────────────────────────────────────────
  We only pass the product ID from Liquid. The JS reads the actual review
  data from window.jdgm.data.reviewWidget[productId], which is the exact
  same object Judge.me's own inline script populates above — so no Liquid
  metafield traversal needed (which is unreliable for JSON metafields).

  The block renders as long as the review_widget_data metafield exists,
  meaning Judge.me has synced at least one review for this product.
{%- endcomment -%}

{%- if product.metafields.judgeme.review_widget_data != blank -%}

  <script id="ProductReviewData" type="application/json">{"productId": {{ product.id }}}</script>

  <div id="ReviewToast" class="review-toast" hidden>
    <button class="review-toast__close" aria-label="Close">×</button>
    <div class="review-toast__avatar" aria-hidden="true"></div>
    <div class="review-toast__content">
      <div class="review-toast__name"></div>
      <div class="review-toast__stars"></div>
      <div class="review-toast__text"></div>
    </div>
  </div>

  {%- comment -%} ReviewBadge (bottom-right pill) is rendered globally in layout/theme.liquid {%- endcomment -%}

{%- endif -%}

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "product", "id": "related_product_1", "label": "You May Also Like — Product 1" },
    { "type": "product", "id": "related_product_2", "label": "You May Also Like — Product 2" },
    { "type": "product", "id": "related_product_3", "label": "You May Also Like — Product 3" },
    { "type": "product", "id": "related_product_4", "label": "You May Also Like — Product 4" }
  ]
}
{% endschema %}
