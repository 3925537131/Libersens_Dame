<section class="lbs section{% if section.settings.cream_background %} section--cream{% endif %}">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
    </div>
    <div class="experts">
      {%- for block in section.blocks -%}
        <div class="expert" {{ block.shopify_attributes }}>
          <div class="expert__avatar"{% if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 400 }})"{% endif %}></div>
          <h3>{{ block.settings.name }}</h3>
          {%- if block.settings.role != blank -%}<div class="role">{{ block.settings.role }}</div>{%- endif -%}
          {%- if block.settings.bio != blank -%}<p>{{ block.settings.bio }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LBS Advisory board",
  "tag": "section",
  "class": "section-lbs-experts",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Backed by science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "User-Tested, Doctor Approved" },
    { "type": "text", "id": "description", "label": "Description", "default": "Our medical & sexual health advisory board guides everything we make." },
    { "type": "checkbox", "id": "cream_background", "label": "Cream background", "default": true }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Dr. Mara Ellis" },
        { "type": "text", "id": "role", "label": "Role", "default": "OB-GYN" },
        { "type": "textarea", "id": "bio", "label": "Bio", "default": "Clinical advisor on body-safe materials and pelvic health." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Advisory board",
      "blocks": [
        { "type": "expert", "settings": { "name": "Dr. Mara Ellis", "role": "OB-GYN", "bio": "Clinical advisor on body-safe materials and pelvic health." } },
        { "type": "expert", "settings": { "name": "Dr. Naomi Reyes", "role": "Sex Therapist", "bio": "Guides our approach to desire, intimacy, and education." } },
        { "type": "expert", "settings": { "name": "Priya Anand, ND", "role": "Naturopath", "bio": "Develops our pH-balanced personal care formulas." } },
        { "type": "expert", "settings": { "name": "Dr. Lena Fox", "role": "Pelvic PT", "bio": "Advises on ergonomics and comfort across the range." } }
      ]
    }
  ]
}
{% endschema %}
