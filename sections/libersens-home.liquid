{%- comment -%}
  Libersens custom homepage — dame.com-inspired full-page design.
  Self-contained: includes announcement bar, header, all content sections, and footer.
  All CSS is scoped under #libersens so it does not collide with Dawn's base styles.
  When this section is active on the homepage, theme.liquid suppresses the global
  header-group / footer-group (see {% unless template.name == 'index' %} there).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
#libersens{
  --blue:#0029FF; --blue-dark:#00006f; --ink:#0c0c2b; --coral:#E95938;
  --lavender:#c4c3f2; --peach:#f9e1d5; --lime:#e9f1b3; --mint:#def1ee;
  --cream:#fbf9f8; --white:#ffffff; --grey:#6d655a; --line:#e6e3df;
  --serif:'Fraunces',Georgia,serif; --sans:'Manrope',system-ui,-apple-system,sans-serif;
  --maxw:1280px;
  font-family:var(--sans); color:var(--ink); background:var(--white);
  line-height:1.5; letter-spacing:normal; -webkit-font-smoothing:antialiased;
  font-size:16px;
}
#libersens *,#libersens *::before,#libersens *::after{box-sizing:border-box;margin:0;padding:0}
#libersens img{max-width:100%;display:block}
#libersens a{color:inherit;text-decoration:none}
#libersens h1,#libersens h2,#libersens h3,#libersens h4{font-family:var(--serif);font-weight:500;line-height:1.05;letter-spacing:-.01em}
#libersens .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
#libersens .eyebrow{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
#libersens .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--sans);font-weight:700;font-size:15px;padding:15px 30px;border-radius:999px;border:2px solid var(--blue);cursor:pointer;transition:.15s;white-space:nowrap}
#libersens .btn--primary{background:var(--blue);color:#fff}
#libersens .btn--primary:hover{background:var(--blue-dark);border-color:var(--blue-dark)}
#libersens .btn--outline{background:transparent;color:var(--blue)}
#libersens .btn--outline:hover{background:var(--blue);color:#fff}
#libersens .btn--coral{background:var(--coral);border-color:var(--coral);color:#fff}
#libersens .btn--coral:hover{filter:brightness(.93)}

#libersens .lbs-announce{background:var(--blue);color:#fff;text-align:center;font-size:13px;font-weight:600;letter-spacing:.02em;padding:10px 16px;display:flex;align-items:center;justify-content:center;gap:10px}
#libersens .lbs-announce a{text-decoration:underline;text-underline-offset:2px}

#libersens .lbs-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--line)}
#libersens .lbs-header__inner{display:flex;align-items:center;justify-content:space-between;height:72px;gap:24px}
#libersens .lbs-logo{font-family:var(--serif);font-weight:600;font-size:28px;letter-spacing:-.02em;color:var(--blue)}
#libersens .lbs-nav{display:flex;gap:28px;align-items:center}
#libersens .lbs-nav a{font-size:14px;font-weight:600;position:relative;padding:6px 0}
#libersens .lbs-nav a:hover{color:var(--blue)}
#libersens .lbs-nav .accent{color:var(--coral)}
#libersens .lbs-actions{display:flex;align-items:center;gap:18px}
#libersens .icon-btn{background:none;border:none;cursor:pointer;color:var(--ink);display:flex;align-items:center}
#libersens .icon-btn:hover{color:var(--blue)}
#libersens .cart-count{background:var(--coral);color:#fff;font-size:11px;font-weight:700;border-radius:999px;min-width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;margin-left:-6px;margin-top:-12px}
#libersens .burger{display:none}

#libersens .hero{background:var(--lavender);overflow:hidden}
#libersens .hero__grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:560px}
#libersens .hero__copy{padding:64px 24px;max-width:560px;margin-left:auto}
#libersens .hero__copy .eyebrow{color:var(--blue);margin-bottom:18px;display:block}
#libersens .hero h1{font-size:clamp(40px,5.5vw,76px);margin-bottom:22px}
#libersens .hero h1 em{font-style:italic;color:var(--blue)}
#libersens .hero p{font-size:18px;color:#33324a;max-width:440px;margin-bottom:30px}
#libersens .hero__cta{display:flex;gap:14px;flex-wrap:wrap}
#libersens .hero__img{align-self:stretch;background:radial-gradient(circle at 30% 30%, var(--peach), transparent 60%),radial-gradient(circle at 80% 70%, var(--mint), transparent 55%),linear-gradient(135deg,#a9a7ee,#d9d8fb);display:flex;align-items:center;justify-content:center;position:relative}
#libersens .hero__img span{font-family:var(--serif);font-style:italic;font-size:22px;color:#fff;opacity:.9;background:rgba(0,41,255,.25);padding:10px 22px;border-radius:999px;backdrop-filter:blur(4px)}

#libersens .infobar{background:var(--blue);color:#fff}
#libersens .infobar__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:30px 24px;text-align:center}
#libersens .infobar__item{display:flex;flex-direction:column;align-items:center;gap:10px}
#libersens .infobar__item svg{width:30px;height:30px;stroke:#fff}
#libersens .infobar__item strong{font-size:15px;font-weight:700}
#libersens .infobar__item span{font-size:12.5px;opacity:.85;max-width:180px}

#libersens .section{padding:80px 0}
#libersens .section--cream{background:var(--cream)}
#libersens .section__head{text-align:center;max-width:620px;margin:0 auto 46px}
#libersens .section__head .eyebrow{color:var(--blue);margin-bottom:14px;display:block}
#libersens .section__head h2{font-size:clamp(30px,4vw,48px);margin-bottom:14px}
#libersens .section__head p{color:var(--grey);font-size:16px}

#libersens .products{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
#libersens .card{background:#fff;border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:.18s}
#libersens .card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(12,12,43,.08)}
#libersens .card__img{aspect-ratio:1;display:flex;align-items:flex-end;justify-content:center;padding:14px;position:relative}
#libersens .card__badge{position:absolute;top:12px;left:12px;background:var(--coral);color:#fff;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:5px 9px;border-radius:999px}
#libersens .card__swatches{position:absolute;bottom:12px;left:12px;display:flex;gap:6px}
#libersens .swatch{width:16px;height:16px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.08)}
#libersens .card__body{padding:16px 16px 20px}
#libersens .card__rating{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--grey);margin-bottom:6px}
#libersens .stars{color:var(--coral);letter-spacing:1px;font-size:13px}
#libersens .card__name{font-family:var(--serif);font-size:19px;margin-bottom:4px}
#libersens .card__desc{font-size:12.5px;color:var(--grey);margin-bottom:12px}
#libersens .card__row{display:flex;align-items:center;justify-content:space-between}
#libersens .card__price{font-weight:800;font-size:16px}
#libersens .card__add{font-size:13px;font-weight:700;color:var(--blue);border:2px solid var(--blue);padding:7px 14px;border-radius:999px;background:none;cursor:pointer}
#libersens .card__add:hover{background:var(--blue);color:#fff}
#libersens .center-cta{text-align:center;margin-top:42px}

#libersens .tabs{text-align:center}
#libersens .tabs__nav{display:inline-flex;gap:8px;background:#fff;border:1px solid var(--line);padding:6px;border-radius:999px;margin-bottom:40px;flex-wrap:wrap;justify-content:center}
#libersens .tab{border:none;background:none;font-family:var(--sans);font-weight:700;font-size:14px;padding:10px 22px;border-radius:999px;cursor:pointer;color:var(--ink);transition:.15s}
#libersens .tab.active{background:var(--blue);color:#fff}
#libersens .tabs__panel{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
#libersens .cat-card{border-radius:18px;aspect-ratio:.85;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;color:var(--ink);position:relative;overflow:hidden}
#libersens .cat-card h3{font-size:24px;margin-bottom:6px}
#libersens .cat-card span{font-size:13px;font-weight:700;color:var(--blue);display:inline-flex;align-items:center;gap:6px}

#libersens .ticker{background:var(--ink);color:#fff;padding:26px 0;overflow:hidden}
#libersens .ticker__track{display:flex;gap:64px;white-space:nowrap;animation:lbs-scroll 28s linear infinite;width:max-content}
#libersens .ticker__track span{font-family:var(--serif);font-size:26px;font-style:italic;opacity:.8;letter-spacing:.02em}
@keyframes lbs-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

#libersens .story{display:grid;grid-template-columns:1fr 1fr;align-items:center;background:var(--mint)}
#libersens .story__img{min-height:520px;background:radial-gradient(circle at 70% 30%, var(--peach), transparent 55%),linear-gradient(135deg,#bfe7df,#9fd8cd)}
#libersens .story__copy{padding:72px 64px}
#libersens .story__copy .eyebrow{color:var(--blue);margin-bottom:16px;display:block}
#libersens .story__copy h2{font-size:clamp(28px,3.6vw,44px);margin-bottom:20px}
#libersens .story__copy p{color:#2c4742;font-size:16px;margin-bottom:16px;max-width:480px}

#libersens .experts{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
#libersens .expert{text-align:center}
#libersens .expert__avatar{aspect-ratio:1;border-radius:50%;margin:0 auto 16px;width:160px;background:linear-gradient(135deg,var(--lavender),var(--lime))}
#libersens .expert h3{font-size:20px;margin-bottom:4px}
#libersens .expert .role{font-size:12px;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px}
#libersens .expert p{font-size:13.5px;color:var(--grey);max-width:240px;margin:0 auto}

#libersens .podcast{background:var(--coral);color:#fff}
#libersens .podcast__grid{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:40px;padding:64px 0}
#libersens .podcast .eyebrow{margin-bottom:14px;display:block;opacity:.85}
#libersens .podcast h2{font-size:clamp(30px,4vw,52px);margin-bottom:18px;color:#fff}
#libersens .podcast p{font-size:17px;max-width:440px;margin-bottom:26px;opacity:.95}
#libersens .podcast__platforms{display:flex;gap:14px;flex-wrap:wrap}
#libersens .platform{background:rgba(255,255,255,.18);padding:10px 18px;border-radius:999px;font-size:14px;font-weight:700}
#libersens .podcast__art{aspect-ratio:1;border-radius:24px;background:linear-gradient(135deg,#fff,var(--peach));display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-style:italic;font-size:28px;color:var(--coral);max-width:340px;margin-left:auto}

#libersens .reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
#libersens .review{background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px}
#libersens .review .stars{font-size:16px;margin-bottom:14px}
#libersens .review p{font-family:var(--serif);font-size:18px;line-height:1.4;margin-bottom:18px}
#libersens .review .who{font-size:13px;font-weight:700;color:var(--grey)}

#libersens .siblings{display:grid;grid-template-columns:1fr 1fr;gap:24px}
#libersens .sibling{border-radius:20px;padding:48px;display:flex;flex-direction:column;justify-content:center;min-height:240px}
#libersens .sibling h3{font-size:28px;margin-bottom:10px}
#libersens .sibling p{font-size:14px;color:var(--grey);margin-bottom:18px;max-width:340px}

#libersens .newsletter{background:var(--blue);color:#fff;text-align:center}
#libersens .newsletter__inner{padding:80px 24px;max-width:620px;margin:0 auto}
#libersens .newsletter h2{font-size:clamp(30px,4vw,48px);color:#fff;margin-bottom:14px}
#libersens .newsletter p{opacity:.85;margin-bottom:28px;font-size:16px}
#libersens .newsletter__form{display:flex;gap:10px;max-width:460px;margin:0 auto}
#libersens .newsletter input{flex:1;border:none;border-radius:999px;padding:15px 22px;font-size:15px;font-family:var(--sans)}
#libersens .newsletter .fineprint{font-size:12px;opacity:.7;margin-top:16px}

#libersens .blogs{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
#libersens .post__img{aspect-ratio:1.5;border-radius:16px;margin-bottom:18px}
#libersens .post .tag{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--blue);margin-bottom:8px;display:block}
#libersens .post h3{font-size:21px;margin-bottom:10px}
#libersens .post p{font-size:14px;color:var(--grey);margin-bottom:12px}
#libersens .post a.read{font-size:13px;font-weight:700;color:var(--blue)}

#libersens .lbs-footer{background:var(--ink);color:#fff;padding:64px 0 32px}
#libersens .lbs-footer__top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:40px;padding-bottom:48px;border-bottom:1px solid rgba(255,255,255,.12)}
#libersens .lbs-footer__brand .lbs-logo{color:#fff;margin-bottom:14px;display:inline-block}
#libersens .lbs-footer__brand p{font-size:14px;opacity:.7;max-width:280px}
#libersens .lbs-footer__col h4{font-family:var(--sans);font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px;opacity:.6}
#libersens .lbs-footer__col a{display:block;font-size:14px;opacity:.85;margin-bottom:12px}
#libersens .lbs-footer__col a:hover{opacity:1;color:var(--lavender)}
#libersens .lbs-footer__bottom{display:flex;align-items:center;justify-content:space-between;padding-top:28px;font-size:12.5px;opacity:.6;flex-wrap:wrap;gap:14px}
#libersens .lbs-footer__social{display:flex;gap:16px}
#libersens .lbs-footer__social a{opacity:.7}
#libersens .lbs-footer__social a:hover{opacity:1}

@media(max-width:1024px){
  #libersens .products{grid-template-columns:repeat(3,1fr)}
  #libersens .experts{grid-template-columns:repeat(2,1fr)}
  #libersens .tabs__panel{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:820px){
  #libersens .lbs-nav{display:none}
  #libersens .burger{display:flex}
  #libersens .hero__grid,#libersens .story,#libersens .podcast__grid{grid-template-columns:1fr}
  #libersens .hero__copy{padding:48px 24px;margin:0;max-width:none}
  #libersens .hero__img{min-height:300px}
  #libersens .story__img{min-height:300px}
  #libersens .story__copy,#libersens .podcast__grid{padding:48px 24px}
  #libersens .podcast__art{margin:0 auto}
  #libersens .infobar__grid{grid-template-columns:repeat(2,1fr);gap:28px 16px}
  #libersens .products{grid-template-columns:repeat(2,1fr)}
  #libersens .reviews,#libersens .blogs,#libersens .siblings{grid-template-columns:1fr}
  #libersens .lbs-footer__top{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
  #libersens .products,#libersens .experts{grid-template-columns:1fr}
  #libersens .lbs-footer__top{grid-template-columns:1fr}
}
</style>

<div id="libersens">

  <!-- Announcement bar -->
  <div class="lbs-announce">
    <span>✦ Free intimate care mini with every order over $75 — this month only</span>
    <a href="{{ routes.all_products_collection_url }}">Shop now</a>
  </div>

  <!-- Header -->
  <header class="lbs-header">
    <div class="wrap lbs-header__inner">
      <button class="icon-btn burger" aria-label="Menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <a href="{{ routes.root_url }}" class="lbs-logo">Libersens</a>
      <nav class="lbs-nav">
        <a href="#bestsellers">Vibrators</a>
        <a href="{{ routes.all_products_collection_url }}">Shop All</a>
        <a href="#categories">Personal Care</a>
        <a href="#story">About</a>
        <a href="#quiz" class="accent">Find Your Vibe</a>
      </nav>
      <div class="lbs-actions">
        <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="M21 21l-6-6"/></svg>
        </a>
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="7" r="4"/><path d="M3 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        </a>
        <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7h12l-1 13H7L6 7zM9 7a3 3 0 0 1 6 0"/></svg>
          <span class="cart-count">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="wrap" style="padding:0">
      <div class="hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">By Women, For Women</span>
          <h1>Pleasure, <em>redesigned</em>.</h1>
          <p>Vibrators and intimate wellness essentials — researched, engineered, and designed by women. Body-safe, beautiful, and built to close the pleasure gap.</p>
          <div class="hero__cta">
            <a href="#bestsellers" class="btn btn--primary">Shop bestsellers</a>
            <a href="#quiz" class="btn btn--outline">Take the quiz</a>
          </div>
        </div>
        <div class="hero__img"><span>Designed for real bodies</span></div>
      </div>
    </div>
  </section>

  <!-- Info / trust bar -->
  <section class="infobar">
    <div class="wrap" style="padding:0">
      <div class="infobar__grid">
        <div class="infobar__item">
          <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"/></svg>
          <strong>Medical-Grade Silicone</strong><span>Body-safe materials you can trust</span>
        </div>
        <div class="infobar__item">
          <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 3s6 6 6 11a6 6 0 0 1-12 0c0-5 6-11 6-11z"/></svg>
          <strong>Waterproof & Rechargeable</strong><span>USB magnetic charging, fully sealed</span>
        </div>
        <div class="infobar__item">
          <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
          <strong>60-Night Trial</strong><span>Love it or your money back</span>
        </div>
        <div class="infobar__item">
          <svg fill="none" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/></svg>
          <strong>12,000+ 5-Star Reviews</strong><span>Loved by a community of women</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Bestsellers -->
  <section class="section section--cream" id="bestsellers">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">Tried & adored</span>
        <h2>Our Bestsellers</h2>
        <p>The pieces our community reaches for again and again.</p>
      </div>
      <div class="products">
        <article class="card">
          <div class="card__img" style="background:var(--peach)">
            <span class="card__badge">Bestseller</span>
            <div class="card__swatches"><span class="swatch" style="background:#E95938"></span><span class="swatch" style="background:#0029FF"></span><span class="swatch" style="background:#c4c3f2"></span></div>
          </div>
          <div class="card__body">
            <div class="card__rating"><span class="stars">★★★★★</span> 1,842 reviews</div>
            <div class="card__name">Vela Wearable</div>
            <div class="card__desc">Hands-free, app-controlled vibrator</div>
            <div class="card__row"><span class="card__price">$129</span><button class="card__add">Add</button></div>
          </div>
        </article>
        <article class="card">
          <div class="card__img" style="background:var(--lavender)">
            <div class="card__swatches"><span class="swatch" style="background:#c4c3f2"></span><span class="swatch" style="background:#def1ee"></span></div>
          </div>
          <div class="card__body">
            <div class="card__rating"><span class="stars">★★★★★</span> 1,109 reviews</div>
            <div class="card__name">Luna Panty Vibe</div>
            <div class="card__desc">Discreet, wearable, remote-controlled</div>
            <div class="card__row"><span class="card__price">$79</span><button class="card__add">Add</button></div>
          </div>
        </article>
        <article class="card">
          <div class="card__img" style="background:var(--mint)">
            <span class="card__badge">New</span>
            <div class="card__swatches"><span class="swatch" style="background:#def1ee"></span><span class="swatch" style="background:#E95938"></span></div>
          </div>
          <div class="card__body">
            <div class="card__rating"><span class="stars">★★★★★</span> 764 reviews</div>
            <div class="card__name">Mira Mini Wand</div>
            <div class="card__desc">Rumbly power in a pocket size</div>
            <div class="card__row"><span class="card__price">$76</span><button class="card__add">Add</button></div>
          </div>
        </article>
        <article class="card">
          <div class="card__img" style="background:var(--lime)">
