<section class="lbs lbs-testimonials-section">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>

  {%- if section.settings.use_judgeme -%}

    <div class="lbs-jm-all wrap">
      <div class='jdgm-carousel-wrapper'>
        {%- assign jm_metafields = shop.metafields.judgeme -%}
        <div class='jdgm-carousel-title-and-link'>
          <span class='jdgm-all-reviews-rating-wrapper'>
            <span style='display:block' data-score='{{ jm_metafields.all_reviews_rating }}' class='jdgm-all-reviews-rating' aria-label='{{ jm_metafields.all_reviews_rating }} stars' tabindex='0' role='img'></span>
            <span style='display:block' class='jdgm-carousel-number-of-reviews' data-number-of-reviews='{{ jm_metafields.all_reviews_count }}'>
              from {{ shop.metafields.judgeme.all_reviews_count }} reviews
            </span>
          </span>
        </div>
        {{ jm_metafields.featured_carousel }}
      </div>
    </div>

  {%- else -%}

    <div class="lbs-rc-outer">
      <button class="lbs-rc-btn lbs-rc-prev" aria-label="Previous reviews">&#8592;</button>
      <div class="lbs-rc-viewport">
        <div class="lbs-rc-track">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="lbs-rc-card" {{ block.shopify_attributes }}>
                <div class="lbs-rc-stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
                <p class="lbs-rc-quote">{{ block.settings.quote }}</p>
                <div class="lbs-rc-author">— {{ block.settings.author }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <button class="lbs-rc-btn lbs-rc-next" aria-label="Next reviews">&#8594;</button>
    </div>

  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      {% render block %}
    {%- endif -%}
  {%- endfor -%}

</section>

<style>
  .lbs-testimonials-section { padding: 64px 0; }
  .lbs-rc-outer {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 40px 32px 0;
  }
  .lbs-rc-viewport {
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }
  .lbs-rc-track {
    display: flex;
    gap: 16px;
    transition: transform 0.4s cubic-bezier(.4,0,.2,1);
    will-change: transform;
  }
  .lbs-rc-card {
    flex-shrink: 0;
    background: #fff;
    border-radius: 14px;
    padding: 28px 24px;
    border: 1px solid #ebe8e4;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .lbs-rc-stars { color: #e07b6a; font-size: 17px; letter-spacing: 2px; }
  .lbs-rc-quote { font-size: 14px; line-height: 1.65; color: var(--ink); flex: 1; margin: 0; }
  .lbs-rc-author { font-size: 13px; font-weight: 600; color: var(--ink); opacity: 0.55; margin-top: auto; }
  .lbs-rc-btn {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid #ddd;
    background: #fff;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    color: var(--ink);
  }
  .lbs-rc-btn:hover:not(:disabled) { background: var(--blue, #0029ff); color: #fff; border-color: var(--blue, #0029ff); }
  .lbs-rc-btn:disabled { opacity: 0.25; cursor: default; }
  @media (max-width: 749px) {
    .lbs-rc-outer { padding: 32px 16px 0; gap: 8px; }
    .lbs-rc-btn { width: 36px; height: 36px; font-size: 15px; }
  }
</style>

<script>
(function () {
  var section = document.querySelector('.lbs-testimonials-section');
  if (!section) return;
  var track = section.querySelector('.lbs-rc-track');
  if (!track) return;
  var viewport = section.querySelector('.lbs-rc-viewport');
  var prevBtn = section.querySelector('.lbs-rc-prev');
  var nextBtn = section.querySelector('.lbs-rc-next');
  var cards = Array.from(track.querySelectorAll('.lbs-rc-card'));
  var total = cards.length;
  var current = 0;
  var gap = 16;

  function perView() { return window.innerWidth < 750 ? 1 : 5; }

  function setWidths() {
    var pv = perView();
    var vw = viewport.offsetWidth;
    var cardW = (vw - gap * (pv - 1)) / pv;
    cards.forEach(function (c) { c.style.width = cardW + 'px'; });
    current = Math.min(current, Math.max(0, total - pv));
    update(false);
  }

  function update(animate) {
    if (animate === false) track.style.transition = 'none';
    else track.style.transition = 'transform 0.4s cubic-bezier(.4,0,.2,1)';
    var pv = perView();
    var cardW = cards[0] ? (cards[0].offsetWidth + gap) : 0;
    track.style.transform = 'translateX(-' + (current * cardW) + 'px)';
    if (prevBtn) prevBtn.disabled = current === 0;
    if (nextBtn) nextBtn.disabled = current >= total - pv;
    if (animate === false) requestAnimationFrame(function () { track.style.transition = ''; });
  }

  if (prevBtn) prevBtn.addEventListener('click', function () {
    current = Math.max(0, current - perView());
    update();
  });
  if (nextBtn) nextBtn.addEventListener('click', function () {
    current = Math.min(total - perView(), current + perView());
    update();
  });

  setWidths();
  window.addEventListener('resize', setWidths);
})();
</script>

{% schema %}
{
  "name": "LBS Testimonials",
  "tag": "section",
  "class": "section-lbs-testimonials",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From our community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    {
      "type": "header",
      "content": "Judge.me reviews"
    },
    {
      "type": "checkbox",
      "id": "use_judgeme",
      "label": "Show Judge.me carousel",
      "info": "Turn on to display your Judge.me Reviews Carousel. Make sure the Judge.me app embed is enabled in Theme Editor → App embeds.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The first product that actually felt like it was made with me in mind." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sofia R." }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "LBS Testimonials",
      "blocks": [
        { "type": "review", "settings": { "quote": "The first product that actually felt like it was made with me in mind. Genuinely life-changing.", "author": "Sofia R." } },
        { "type": "review", "settings": { "quote": "Beautiful, quiet, and powerful. I've recommended Libersens to every friend I have.", "author": "Jess M." } },
        { "type": "review", "settings": { "quote": "Finally a brand that talks about pleasure without shame. The quality is unreal.", "author": "Dani K." } }
      ]
    }
  ]
}
{% endschema %}
