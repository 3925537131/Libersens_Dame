<header class="lbs lbs-header">
  <div class="wrap lbs-header__inner">
    <button class="icon-btn burger" aria-label="Menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a href="{{ routes.root_url }}" class="lbs-logo">{{ section.settings.logo_text | default: shop.name }}</a>

    {%- liquid
      assign vib_coll = collections['vibrators']
      assign acc_coll = collections['accessories']
    -%}
    <nav class="lbs-nav web-nav-dame15">

      {%- comment -%} ══ VIBRATORS — image-card dropdown (max 5 to fit one row) ══ {%- endcomment -%}
      <div class="lbs-nav-item lbs-nav-item--mega">
        <a href="{{ vib_coll.url | default: '/collections/vibrators' }}" class="lbs-nav-link">
          Vibrators
          <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
        </a>
        <div class="lbs-mega">
          <div class="wrap lbs-mega__pad">
            {%- if vib_coll != blank and vib_coll.products_count > 0 -%}
              <div class="lbs-mega-products">
                {%- for product in vib_coll.products limit: 12 -%}
                  <div class="lbs-mega-prod-item">
                    <a href="{{ product.url }}" class="lbs-mega-prod-link">
                      <div class="lbs-mega-prod__img">
                        {%- if product.featured_image -%}
                          <img src="{{ product.featured_image | image_url: width: 320 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="150" height="178" loading="lazy">
                        {%- endif -%}
                      </div>
                      <p class="lbs-mega-prod__name">
                        {{ product.title }}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M13 8l4 4-4 4"/></svg>
                      </p>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <p class="lbs-mega-empty">Add products to a collection with the handle “vibrators”.</p>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} ══ SHOP ALL — two columns (Vibrators / Accessories) ══ {%- endcomment -%}
      <div class="lbs-nav-item lbs-nav-item--mega">
        <a href="/collections/all" class="lbs-nav-link">
          Shop All
          <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
        </a>
        <div class="lbs-mega">
          <div class="wrap lbs-mega__pad">
            <div class="lbs-mega-cols">
              {%- comment -%} Vibrators column {%- endcomment -%}
              <div class="lbs-mega-col">
                <div class="lbs-mega-col__head-row">
                  <a class="lbs-mega-col__head" href="{{ vib_coll.url | default: '/collections/vibrators' }}">Vibrators</a>
                  <span class="lbs-mega-col__arrow">&rarr;</span>
                </div>
                <div class="lbs-mega-col__items">
                  {%- for product in vib_coll.products limit: 4 -%}
                    <a class="lbs-mega-item" href="{{ product.url }}">
                      <span class="lbs-mega-item__img">
                        {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="64" height="64" loading="lazy">{%- endif -%}
                      </span>
                      <span>{{ product.title }}</span>
                    </a>
                  {%- else -%}
                    <p class="lbs-mega-empty">No vibrators yet.</p>
                  {%- endfor -%}
                </div>
              </div>
              {%- comment -%} Accessories column {%- endcomment -%}
              <div class="lbs-mega-col">
                <div class="lbs-mega-col__head-row">
                  <a class="lbs-mega-col__head" href="{{ acc_coll.url | default: '/collections/accessories' }}">Accessories</a>
                  <span class="lbs-mega-col__arrow">&rarr;</span>
                </div>
                <div class="lbs-mega-col__items">
                  {%- for product in acc_coll.products limit: 4 -%}
                    <a class="lbs-mega-item" href="{{ product.url }}">
                      <span class="lbs-mega-item__img">
                        {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="64" height="64" loading="lazy">{%- endif -%}
                      </span>
                      <span>{{ product.title }}</span>
                    </a>
                  {%- else -%}
                    <p class="lbs-mega-empty">Add products to a collection with the handle “accessories”.</p>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} ══ ABOUT — three image cards ══ {%- endcomment -%}
      {%- assign about_url_1 = section.settings.about_url_1 | default: '/pages/about-us' -%}
      {%- assign about_url_2 = section.settings.about_url_2 | default: '/pages/labs' -%}
      {%- assign about_url_3 = section.settings.about_url_3 | default: '/blogs/sexual-wellness' -%}
      <div class="lbs-nav-item lbs-nav-item--mega">
        <a href="{{ about_url_1 }}" class="lbs-nav-link">
          About
          <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
        </a>
        <div class="lbs-mega">
          <div class="wrap lbs-mega__pad">
            <div class="lbs-mega-products lbs-mega-products--about">
              {%- assign ab_labels = 'About Us,Lab,Blog' | split: ',' -%}
              {%- assign ab_tints  = '#e2d1dd,#def1ee,#e9f1b3' | split: ',' -%}
              {%- for i in (0..2) -%}
                {%- if i == 0 -%}{%- assign ab_href = about_url_1 -%}{%- elsif i == 1 -%}{%- assign ab_href = about_url_2 -%}{%- else -%}{%- assign ab_href = about_url_3 -%}{%- endif -%}
                <div class="lbs-mega-prod-item">
                  <a href="{{ ab_href }}" class="lbs-mega-prod-link">
                    <div class="lbs-mega-prod__img lbs-mega-prod__img--text" style="background:{{ ab_tints[i] }}">
                      <span>{{ ab_labels[i] }}</span>
                    </div>
                    <p class="lbs-mega-prod__name">
                      {{ ab_labels[i] }}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M13 8l4 4-4 4"/></svg>
                    </p>
                  </a>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} ══ FIND YOUR VIBE — plain link ══ {%- endcomment -%}
      <div class="lbs-nav-item">
        <a href="{{ section.settings.quiz_url | default: '/pages/find-your-vibe' }}" class="lbs-nav-link accent">Find Your Vibe</a>
      </div>

    </nav>

    <div class="lbs-actions">
      <div class="lbs-search" data-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="lbs-search__form">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <input type="search" name="q" class="lbs-search__input" placeholder="Search products" aria-label="Search" autocomplete="off">
        </form>
        <button type="button" class="icon-btn lbs-search__toggle" aria-label="Search" data-search-toggle>
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="M21 21l-6-6"/></svg>
        </button>
      </div>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="7" r="4"/><path d="M3 21c0-4 4-6 8-6s8 2 8 6"/></svg>
      </a>
      <button type="button" class="icon-btn lbs-cart-btn" aria-label="Cart" data-cart-toggle>
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7h12l-1 13H7L6 7zM9 7a3 3 0 0 1 6 0"/></svg>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} ===== SLIDE-IN CART DRAWER ===== {%- endcomment -%}
<div class="lbs-cart-overlay" data-cart-overlay hidden></div>
<aside class="lbs-cart-drawer" data-cart-drawer aria-label="Shopping cart" aria-hidden="true"
       data-free-ship="{{ section.settings.free_ship_threshold | default: 50 }}">
  <div class="lbs-cart-drawer__head">
    <p class="lbs-cart-drawer__title">Your cart (<span data-cart-count>{{ cart.item_count }}</span>)</p>
    <button type="button" class="lbs-cart-drawer__close" aria-label="Close cart" data-cart-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  {%- if section.settings.free_ship_threshold > 0 -%}
    <div class="lbs-cart-ship" data-cart-ship hidden>
      <p class="lbs-cart-ship__msg" data-ship-msg></p>
      <div class="lbs-cart-ship__track"><div class="lbs-cart-ship__fill" data-ship-fill></div></div>
    </div>
  {%- endif -%}
  <div class="lbs-cart-drawer__body" data-cart-body>
    <p class="lbs-cart-drawer__empty">Your cart is empty.</p>
  </div>
  <div class="lbs-cart-drawer__foot" data-cart-foot hidden>
    <div class="lbs-cart-drawer__subtotal">
      <span>Subtotal</span>
      <span data-cart-subtotal></span>
    </div>
    <p class="lbs-cart-drawer__note">Shipping &amp; taxes calculated at checkout.</p>
    <a href="/checkout" class="lbs-cart-drawer__checkout">Checkout</a>
    <div class="lbs-cart-drawer__trust">
      <span>↩ {{ section.settings.cart_perk_1 | default: '60-Day Returns' }}</span>
      <span>🛡 {{ section.settings.cart_perk_2 | default: '1-Year Warranty' }}</span>
    </div>
  </div>
</aside>

<script>
  (function () {
    var header = document.querySelector('.lbs-header');
    var items = document.querySelectorAll('.lbs-header .lbs-nav-item--mega');
    if (!header || !items.length) return;

    function setMegaTop() {
      var bottom = header.getBoundingClientRect().bottom;
      items.forEach(function (item) {
        var mega = item.querySelector('.lbs-mega');
        if (mega) mega.style.top = bottom + 'px';
      });
    }
    setMegaTop();
    window.addEventListener('scroll', setMegaTop, { passive: true });
    window.addEventListener('resize', setMegaTop);

    var touch = window.matchMedia('(hover: none)').matches;
    items.forEach(function (item) {
      var timer;
      var link = item.querySelector('.lbs-nav-link');

      function open() {
        clearTimeout(timer);
        setMegaTop();
        items.forEach(function (i) { if (i !== item) i.classList.remove('is-open'); });
        item.classList.add('is-open');
      }
      function close() {
        timer = setTimeout(function () { item.classList.remove('is-open'); }, 150);
      }

      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', close);
      if (link) {
        link.addEventListener('focus', open);
        link.addEventListener('click', function (e) {
          if (touch && !item.classList.contains('is-open')) {
            e.preventDefault();
            open();
          }
        });
      }
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.lbs-nav-item--mega')) {
        items.forEach(function (i) { i.classList.remove('is-open'); });
      }
    });
  })();
</script>

<script>
/* ===== Dynamic search: expands an input to the left of the icon ===== */
(function () {
  var wrap = document.querySelector('[data-search]');
  if (!wrap) return;
  var toggle = wrap.querySelector('[data-search-toggle]');
  var input  = wrap.querySelector('.lbs-search__input');
  var form   = wrap.querySelector('.lbs-search__form');
  function open()  { wrap.classList.add('is-open'); input.focus(); }
  function close() { wrap.classList.remove('is-open'); }
  toggle.addEventListener('click', function (e) {
    e.preventDefault();
    if (wrap.classList.contains('is-open')) {
      if (input.value.trim()) { form.submit(); } else { close(); }
    } else { open(); }
  });
  document.addEventListener('click', function (e) {
    if (!wrap.contains(e.target)) close();
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
})();

/* ===== Slide-in cart drawer + AJAX add to cart ===== */
(function () {
  var drawer  = document.querySelector('[data-cart-drawer]');
  var overlay = document.querySelector('[data-cart-overlay]');
  if (!drawer || !overlay) return;
  var body  = drawer.querySelector('[data-cart-body]');
  var foot  = drawer.querySelector('[data-cart-foot]');
  var subEl = drawer.querySelector('[data-cart-subtotal]');
  var counts = document.querySelectorAll('[data-cart-count]');

  function money(cents, currency) {
    try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency || 'USD' }).format(cents / 100); }
    catch (e) { return '$' + (cents / 100).toFixed(2); }
  }
  function openDrawer()  { overlay.hidden = false; drawer.classList.add('is-open'); overlay.classList.add('is-open'); drawer.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
  function closeDrawer() { drawer.classList.remove('is-open'); overlay.classList.remove('is-open'); drawer.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; setTimeout(function(){ overlay.hidden = true; }, 300); }

  var ship    = drawer.querySelector('[data-cart-ship]');
  var shipMsg = drawer.querySelector('[data-ship-msg]');
  var shipFill= drawer.querySelector('[data-ship-fill]');
  var shipThreshold = parseFloat(drawer.dataset.freeShip || '0') * 100;

  function updateShip(cart) {
    if (!ship || shipThreshold <= 0) return;
    if (!cart.items || !cart.items.length) { ship.hidden = true; return; }
    ship.hidden = false;
    var total = cart.total_price;
    var remaining = shipThreshold - total;
    var pct = Math.min(100, Math.round((total / shipThreshold) * 100));
    shipFill.style.width = pct + '%';
    if (remaining <= 0) shipMsg.innerHTML = 'You’ve unlocked <strong>free shipping</strong>! 🎉';
    else shipMsg.innerHTML = 'You’re <strong>' + money(remaining, cart.currency) + '</strong> away from free shipping';
  }

  function render(cart) {
    counts.forEach(function (c) { c.textContent = cart.item_count; });
    updateShip(cart);
    if (!cart.items || !cart.items.length) {
      body.innerHTML = '<p class="lbs-cart-drawer__empty">Your cart is empty.</p>';
      foot.hidden = true;
      return;
    }
    foot.hidden = false;
    subEl.textContent = money(cart.items_subtotal_price != null ? cart.items_subtotal_price : cart.total_price, cart.currency);
    body.innerHTML = cart.items.map(function (it) {
      var img = it.image ? '<img src="' + it.image.replace(/(\.[a-z]+)(\?|$)/i, '_120x$1$2') + '" alt="" loading="lazy">' : '';
      var opts = (it.options_with_values || []).filter(function (o) { return o.value && o.value !== 'Default Title'; })
        .map(function (o) { return o.value; }).join(' · ');
      return '<div class="lbs-ci" data-key="' + it.key + '">' +
          '<a class="lbs-ci__img" href="' + it.url + '">' + img + '</a>' +
          '<div class="lbs-ci__info">' +
            '<a class="lbs-ci__title" href="' + it.url + '">' + it.product_title + '</a>' +
            (opts ? '<p class="lbs-ci__opts">' + opts + '</p>' : '') +
            '<div class="lbs-ci__row">' +
              '<div class="lbs-ci__qty">' +
                '<button type="button" data-qty-dec aria-label="Decrease">−</button>' +
                '<span>' + it.quantity + '</span>' +
                '<button type="button" data-qty-inc aria-label="Increase">+</button>' +
              '</div>' +
              '<span class="lbs-ci__price">' + money(it.final_line_price, cart.currency) + '</span>' +
            '</div>' +
            '<button type="button" class="lbs-ci__remove" data-remove>Remove</button>' +
          '</div>' +
        '</div>';
    }).join('');
  }

  function getCart() { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }); }
  function refresh(open) { return getCart().then(function (c) { render(c); if (open) openDrawer(); return c; }); }
  function change(key, qty) {
    return fetch('/cart/change.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(function (r) { return r.json(); }).then(function (c) { render(c); return c; });
  }

  /* Open drawer from cart icon(s) */
  document.querySelectorAll('[data-cart-toggle]').forEach(function (b) {
    b.addEventListener('click', function (e) { e.preventDefault(); refresh(true); });
  });
  drawer.querySelector('[data-cart-close]').addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrawer(); });

  /* Qty +/- and remove (event delegation) */
  body.addEventListener('click', function (e) {
    var row = e.target.closest('[data-key]');
    if (!row) return;
    var key = row.dataset.key;
    var qtyEl = row.querySelector('.lbs-ci__qty span');
    var qty = parseInt(qtyEl ? qtyEl.textContent : '1', 10);
    if (e.target.closest('[data-remove]')) change(key, 0);
    else if (e.target.closest('[data-qty-inc]')) change(key, qty + 1);
    else if (e.target.closest('[data-qty-dec]')) change(key, Math.max(0, qty - 1));
  });

  /* Intercept every add-to-cart form -> AJAX add -> open drawer */
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || form.getAttribute('action') == null) return;
    if (form.getAttribute('action').indexOf('/cart/add') === -1) return;
    e.preventDefault();
    var btn = form.querySelector('[type="submit"]');
    if (btn) btn.classList.add('is-loading');
    fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
      .then(function (r) { return r.json(); })
      .then(function () { return refresh(true); })
      .catch(function () { form.submit(); })
      .finally(function () { if (btn) btn.classList.remove('is-loading'); });
  });
})();
</script>

{% schema %}
{
  "name": "LBS Header",
  "tag": "section",
  "class": "section-lbs-header",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Libersens" },
    { "type": "header", "content": "Nav links" },
    { "type": "paragraph", "content": "Vibrators & Shop All dropdowns auto-populate from collections with the handles ‘vibrators’ and ‘accessories’." },
    { "type": "url", "id": "about_url_1", "label": "About card 1 link (About Us)" },
    { "type": "url", "id": "about_url_2", "label": "About card 2 link (Lab)" },
    { "type": "url", "id": "about_url_3", "label": "About card 3 link (Blog)" },
    { "type": "url", "id": "quiz_url", "label": "Find Your Vibe link" },
    { "type": "header", "content": "Cart drawer" },
    { "type": "number", "id": "free_ship_threshold", "label": "Free shipping threshold", "info": "Amount in your currency for the free-shipping progress bar. Set 0 to hide.", "default": 50 },
    { "type": "text", "id": "cart_perk_1", "label": "Cart perk 1", "default": "60-Day Returns" },
    { "type": "text", "id": "cart_perk_2", "label": "Cart perk 2", "default": "1-Year Warranty" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link (no dropdown)",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "accent", "label": "Highlight (coral)", "default": false }
      ]
    },
    {
      "type": "mega_collection",
      "name": "Collection dropdown",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Vibrators" },
        { "type": "collection", "id": "collection", "label": "Collection to show" },
        { "type": "range", "id": "products_count", "label": "Products in dropdown", "min": 3, "max": 8, "step": 1, "default": 5 },
        { "type": "url", "id": "link", "label": "Fallback link (if no collection)" },
        { "type": "checkbox", "id": "accent", "label": "Highlight (coral)", "default": false }
      ]
    },
    {
      "type": "mega_menu",
      "name": "Dropdown: mega menu",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop All" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Build a nested menu in Online Store → Navigation. Top-level links become column headings; their child links become items (link them to products to show thumbnails)." },
        { "type": "url", "id": "link", "label": "Heading link" },
        { "type": "checkbox", "id": "accent", "label": "Highlight (coral)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Header",
      "blocks": [
        { "type": "mega_collection", "settings": { "label": "Vibrators" } },
        { "type": "mega_menu", "settings": { "label": "Shop All" } },
        { "type": "link", "settings": { "label": "About" } },
        { "type": "link", "settings": { "label": "Find Your Vibe", "accent": true } }
      ]
    }
  ]
}
{% endschema %}
