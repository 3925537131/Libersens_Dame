<header class="lbs lbs-header">
  <div class="wrap lbs-header__inner">
    <button class="icon-btn burger" aria-label="Menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a href="{{ routes.root_url }}" class="lbs-logo">{{ section.settings.logo_text | default: shop.name }}</a>

    <nav class="lbs-nav">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

        {%- when 'mega_collection' -%}
          {%- assign mega_collection = collections[block.settings.collection] -%}
          <div class="lbs-nav-item lbs-nav-item--mega" {{ block.shopify_attributes }}>
            <a href="{% if mega_collection != blank %}{{ mega_collection.url }}{% else %}{{ block.settings.link | default: '#' }}{% endif %}" class="lbs-nav-link{% if block.settings.accent %} accent{% endif %}">
              {{ block.settings.label }}
              <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
            </a>
            <div class="lbs-mega">
              <div class="wrap lbs-mega__pad">
                {%- if mega_collection != blank and mega_collection.products_count > 0 -%}
                  <div class="lbs-mega-products">
                    {%- for product in mega_collection.products limit: block.settings.products_count -%}
                      <div class="lbs-mega-prod-item">
                        <a href="{{ product.url }}" class="lbs-mega-prod-link">
                          <div class="lbs-mega-prod__img">
                            {%- if product.featured_image -%}
                              <img src="{{ product.featured_image | image_url: width: 320 }}" alt="{{ product.featured_image.alt | escape }}" width="150" height="178" loading="lazy">
                            {%- endif -%}
                          </div>
                          <p class="lbs-mega-prod__name">
                            {{ product.title }}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M13 8l4 4-4 4"/></svg>
                          </p>
                        </a>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <p class="lbs-mega-empty">Pick a collection for this dropdown in the theme editor.</p>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- when 'mega_menu' -%}
          {%- assign mega_list = linklists[block.settings.menu] -%}
          <div class="lbs-nav-item lbs-nav-item--mega" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="lbs-nav-link{% if block.settings.accent %} accent{% endif %}">
              {{ block.settings.label }}
              <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
            </a>
            <div class="lbs-mega">
              <div class="wrap lbs-mega__pad">
                {%- if mega_list != blank and mega_list.links.size > 0 -%}
                  <div class="lbs-mega-cols">
                    {%- for column in mega_list.links -%}
                      <div class="lbs-mega-col">
                        <div class="lbs-mega-col__head-row">
                          <a class="lbs-mega-col__head" href="{{ column.url }}">{{ column.title }}</a>
                          <span class="lbs-mega-col__arrow">&rarr;</span>
                        </div>
                        <div class="lbs-mega-col__items">
                          {%- for item in column.links -%}
                            <a class="lbs-mega-item" href="{{ item.url }}">
                              {%- if item.type == 'product_link' and item.object.featured_image -%}
                                <span class="lbs-mega-item__img"><img src="{{ item.object.featured_image | image_url: width: 120 }}" alt="" width="64" height="64" loading="lazy"></span>
                              {%- endif -%}
                              <span>{{ item.title }}</span>
                            </a>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <p class="lbs-mega-empty">Pick a navigation menu in the theme editor (Online Store &rarr; Navigation). Top-level links = column headings, child links = items.</p>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- else -%}
          <div class="lbs-nav-item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="lbs-nav-link{% if block.settings.accent %} accent{% endif %}">{{ block.settings.label }}</a>
          </div>

        {%- endcase -%}
      {%- endfor -%}
    </nav>

    <div class="lbs-actions">
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="M21 21l-6-6"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="7" r="4"/><path d="M3 21c0-4 4-6 8-6s8 2 8 6"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7h12l-1 13H7L6 7zM9 7a3 3 0 0 1 6 0"/></svg>
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<script>
  (function () {
    var header = document.querySelector('.lbs-header');
    var items = document.querySelectorAll('.lbs-header .lbs-nav-item--mega');
    if (!header || !items.length) return;

    function setMegaTop() {
      var bottom = header.getBoundingClientRect().bottom;
      items.forEach(function (item) {
        var mega = item.querySelector('.lbs-mega');
        if (mega) mega.style.top = bottom + 'px';
      });
    }
    setMegaTop();
    window.addEventListener('scroll', setMegaTop, { passive: true });
    window.addEventListener('resize', setMegaTop);

    var touch = window.matchMedia('(hover: none)').matches;
    items.forEach(function (item) {
      var timer;
      var link = item.querySelector('.lbs-nav-link');

      function open() {
        clearTimeout(timer);
        setMegaTop();
        items.forEach(function (i) { if (i !== item) i.classList.remove('is-open'); });
        item.classList.add('is-open');
      }
      function close() {
        timer = setTimeout(function () { item.classList.remove('is-open'); }, 150);
      }

      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', close);
      if (link) {
        link.addEventListener('focus', open);
        link.addEventListener('click', function (e) {
          if (touch && !item.classList.contains('is-open')) {
            e.preventDefault();
            open();
          }
        });
      }
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.lbs-nav-item--mega')) {
        items.forEach(function (i) { i.classList.remove('is-open'); });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "LBS Header",
  "tag": "section",
  "class": "section-lbs-header",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Libersens" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link (no dropdown)",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "accent", "label": "Highlight (coral)", "default": false }
      ]
    },
    {
      "type": "mega_collection",
      "name": "Collection dropdown",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Vibrators" },
        { "type": "collection", "id": "collection", "label": "Collection to show" },
        { "type": "range", "id": "products_count", "label": "Products in dropdown", "min": 3, "max": 8, "step": 1, "default": 5 },
        { "type": "url", "id": "link", "label": "Fallback link (if no collection)" },
        { "type": "checkbox", "id": "accent", "label": "Highlight (coral)", "default": false }
      ]
    },
    {
      "type": "mega_menu",
      "name": "Dropdown: mega menu",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop All" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Build a nested menu in Online Store → Navigation. Top-level links become column headings; their child links become items (link them to products to show thumbnails)." },
        { "type": "url", "id": "link", "label": "Heading link" },
        { "type": "checkbox", "id": "accent", "label": "Highlight (coral)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Header",
      "blocks": [
        { "type": "mega_collection", "settings": { "label": "Vibrators" } },
        { "type": "mega_menu", "settings": { "label": "Shop All" } },
        { "type": "link", "settings": { "label": "About" } },
        { "type": "link", "settings": { "label": "Find Your Vibe", "accent": true } }
      ]
    }
  ]
}
{% endschema %}
