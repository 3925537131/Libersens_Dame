<header class="lbs lbs-header">
  <div class="wrap lbs-header__inner">
    <button class="icon-btn burger" aria-label="Menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <a href="{{ routes.root_url }}" class="lbs-logo">{{ section.settings.logo_text | default: shop.name }}</a>

    {%- liquid
      assign vib_coll = collections['vibrators']
      assign acc_coll = collections['accessories']
    -%}
    <nav class="lbs-nav web-nav-dame15">

      {%- comment -%} ══ VIBRATORS — image-card dropdown (max 5 to fit one row) ══ {%- endcomment -%}
      <div class="lbs-nav-item lbs-nav-item--mega">
        <a href="{{ vib_coll.url | default: '/collections/vibrators' }}" class="lbs-nav-link">
          Vibrators
          <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
        </a>
        <div class="lbs-mega">
          <div class="wrap lbs-mega__pad">
            {%- if vib_coll != blank and vib_coll.products_count > 0 -%}
              <div class="lbs-mega-products">
                {%- for product in vib_coll.products limit: 12 -%}
                  <div class="lbs-mega-prod-item">
                    <a href="{{ product.url }}" class="lbs-mega-prod-link">
                      <div class="lbs-mega-prod__img">
                        {%- if product.featured_image -%}
                          <img src="{{ product.featured_image | image_url: width: 320 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="150" height="178" loading="lazy">
                        {%- endif -%}
                      </div>
                      <p class="lbs-mega-prod__name">
                        {{ product.title }}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M13 8l4 4-4 4"/></svg>
                      </p>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <p class="lbs-mega-empty">Add products to a collection with the handle “vibrators”.</p>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} ══ SHOP ALL — two columns (Vibrators / Accessories) ══ {%- endcomment -%}
      <div class="lbs-nav-item lbs-nav-item--mega">
        <a href="/collections/all" class="lbs-nav-link">
          Shop All
          <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
        </a>
        <div class="lbs-mega">
          <div class="wrap lbs-mega__pad">
            <div class="lbs-mega-cols">
              {%- comment -%} Vibrators column {%- endcomment -%}
              <div class="lbs-mega-col">
                <div class="lbs-mega-col__head-row">
                  <a class="lbs-mega-col__head" href="{{ vib_coll.url | default: '/collections/vibrators' }}">Vibrators</a>
                  <span class="lbs-mega-col__arrow">&rarr;</span>
                </div>
                <div class="lbs-mega-col__items">
                  {%- for product in vib_coll.products limit: 4 -%}
                    <a class="lbs-mega-item" href="{{ product.url }}">
                      <span class="lbs-mega-item__img">
                        {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="64" height="64" loading="lazy">{%- endif -%}
                      </span>
                      <span>{{ product.title }}</span>
                    </a>
                  {%- else -%}
                    <p class="lbs-mega-empty">No vibrators yet.</p>
                  {%- endfor -%}
                </div>
              </div>
              {%- comment -%} Accessories column {%- endcomment -%}
              <div class="lbs-mega-col">
                <div class="lbs-mega-col__head-row">
                  <a class="lbs-mega-col__head" href="{{ acc_coll.url | default: '/collections/accessories' }}">Accessories</a>
                  <span class="lbs-mega-col__arrow">&rarr;</span>
                </div>
                <div class="lbs-mega-col__items">
                  {%- for product in acc_coll.products limit: 4 -%}
                    <a class="lbs-mega-item" href="{{ product.url }}">
                      <span class="lbs-mega-item__img">
                        {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="64" height="64" loading="lazy">{%- endif -%}
                      </span>
                      <span>{{ product.title }}</span>
                    </a>
                  {%- else -%}
                    <p class="lbs-mega-empty">Add products to a collection with the handle “accessories”.</p>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} ══ ABOUT — three image cards ══ {%- endcomment -%}
      {%- assign about_url_1 = section.settings.about_url_1 | default: '/pages/about-us' -%}
      {%- assign about_url_2 = section.settings.about_url_2 | default: '/pages/labs' -%}
      {%- assign about_url_3 = section.settings.about_url_3 | default: '/blogs/sexual-wellness' -%}
      <div class="lbs-nav-item lbs-nav-item--mega">
        <a href="{{ about_url_1 }}" class="lbs-nav-link">
          About
          <svg class="lbs-caret" viewBox="0 0 10 6" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/></svg>
        </a>
        <div class="lbs-mega">
          <div class="wrap lbs-mega__pad">
            <div class="lbs-mega-products lbs-mega-products--about">
              {%- assign ab_labels = 'About Us,Lab,Blog' | split: ',' -%}
              {%- assign ab_tints  = '#e2d1dd,#def1ee,#e9f1b3' | split: ',' -%}
              {%- for i in (0..2) -%}
                {%- if i == 0 -%}{%- assign ab_href = about_url_1 -%}{%- elsif i == 1 -%}{%- assign ab_href = about_url_2 -%}{%- else -%}{%- assign ab_href = about_url_3 -%}{%- endif -%}
                <div class="lbs-mega-prod-item">
                  <a href="{{ ab_href }}" class="lbs-mega-prod-link">
                    <div class="lbs-mega-prod__img lbs-mega-prod__img--text" style="background:{{ ab_tints[i] }}">
                      <span>{{ ab_labels[i] }}</span>
                    </div>
                    <p class="lbs-mega-prod__name">
                      {{ ab_labels[i] }}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M13 8l4 4-4 4"/></svg>
                    </p>
                  </a>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} ══ FIND YOUR VIBE — plain link ══ {%- endcomment -%}
      <div class="lbs-nav-item">
        <a href="{{ section.settings.quiz_url | default: '/pages/find-your-vibe' }}" class="lbs-nav-link accent">Find Your Vibe</a>
      </div>

    </nav>

    <div class="lbs-actions">
      <div class="lbs-search" data-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="lbs-search__form">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <input type="search" name="q" class="lbs-search__input" placeholder="Search products" aria-label="Search" autocomplete="off">
        </form>
        <button type="button" class="icon-btn lbs-search__toggle" aria-label="Search" data-search-toggle>
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="M21 21l-6-6"/></svg>
        </button>
      </div>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="7" r="4"/><path d="M3 21c0-4 4-6 8-6s8 2 8 6"/></svg>
      </a>
      <button type="button" class="icon-btn lbs-cart-btn" aria-label="Cart" data-cart-toggle>
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 7h12l-1 13H7L6 7zM9 7a3 3 0 0 1 6 0"/></svg>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} ===== SLIDE-IN CART DRAWER ===== {%- endcomment -%}
<div class="lbs lbs-cart-overlay" data-cart-overlay hidden></div>
<aside class="lbs lbs-cart-drawer" data-cart-drawer aria-label="Shopping cart" aria-hidden="true"
       data-free-ship="{{ section.settings.free_ship_threshold | default: 50 }}">
  <div class="lbs-cart-drawer__head">
    <p class="lbs-cart-drawer__title">Your cart (<span data-cart-count>{{ cart.item_count }}</span>)</p>
    <button type="button" class="lbs-cart-drawer__close" aria-label="Close cart" data-cart-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  {%- if section.settings.free_ship_threshold > 0 -%}
    <div class="lbs-cd-progress" data-cart-ship hidden>
      <div class="lbs-cd-progress__milestone" data-ship-ms>
        <svg class="lbs-cd-progress__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg>
        <span class="lbs-cd-progress__label">Free Shipping</span>
      </div>
      <div class="lbs-cd-progress__track"><div class="lbs-cd-progress__fill" data-ship-fill></div></div>
      <p class="lbs-cd-progress__msg" data-ship-msg></p>
    </div>
  {%- endif -%}
  <div class="lbs-cart-drawer__body" data-cart-body>
    <p class="lbs-cart-drawer__empty">Your cart is empty.</p>
  </div>

  {%- comment -%} You may also like — recommendations populated by JS {%- endcomment -%}
  <div class="lbs-cd-recs" data-cart-recs hidden>
    <div class="lbs-cd-recs__head">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3c0 3-4 4-4 8a4 4 0 008 0c0-1.5-1-2.5-1-2.5C16 11 18 13 18 16a6 6 0 11-12 0c0-5 6-7 6-13z"/></svg>
      <h3 class="lbs-cd-recs__title">You may also like</h3>
    </div>
    <div class="lbs-cd-recs__track" data-recs-track></div>
  </div>

  <div class="lbs-cart-drawer__foot" data-cart-foot hidden>
    <div class="lbs-cart-drawer__subtotal">
      <span>Subtotal</span>
      <span data-cart-subtotal></span>
    </div>
    <a href="/checkout" class="lbs-cart-drawer__checkout">Checkout</a>
    <div class="lbs-cart-drawer__trust">
      <span class="lbs-cart-drawer__perk">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l4-4M3 8l4 4M3 8h12a6 6 0 016 6v2"/></svg>
        {{ section.settings.cart_perk_1 | default: '60-Day Returns' }}
      </span>
      <span class="lbs-cart-drawer__perk">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4" stroke-linecap="round"/></svg>
        {{ section.settings.cart_perk_2 | default: '1-Year Warranty' }}
      </span>
    </div>
  </div>
</aside>

{%- comment -%} ===== MOBILE MENU DRAWER ===== {%- endcomment -%}
<div class="lbs lbs-mmenu-overlay" data-mmenu-overlay hidden></div>
<aside class="lbs lbs-mmenu" data-mmenu aria-hidden="true" aria-label="Menu">
  <div class="lbs-mmenu__head">
    <span class="lbs-mmenu__logo">{{ section.settings.logo_text | default: shop.name }}</span>
    <button type="button" class="lbs-mmenu__close" aria-label="Close menu" data-mmenu-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav class="lbs-mmenu__nav">
    <a href="{{ vib_coll.url | default: '/collections/vibrators' }}">Vibrators</a>
    <a href="/collections/all">Shop All</a>
    <a href="{{ about_url_1 }}">About</a>
    <a href="{{ about_url_2 }}">Lab</a>
    <a href="{{ about_url_3 }}">Blog</a>
    <a href="{{ section.settings.quiz_url | default: '/pages/find-your-vibe' }}" class="lbs-mmenu__accent">Find Your Vibe</a>
  </nav>
  <div class="lbs-mmenu__foot">
    <a href="{{ routes.account_url }}">Account</a>
  </div>
</aside>

{%- comment -%} ===== MOBILE SEARCH POPUP ===== {%- endcomment -%}
<div class="lbs lbs-msearch" data-msearch hidden>
  <form action="{{ routes.search_url }}" method="get" role="search" class="lbs-msearch__form">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="9" r="7"/><path d="M19 19l-5-5"/></svg>
    <input type="search" name="q" class="lbs-msearch__input" placeholder="Search products" aria-label="Search" autocomplete="off" data-msearch-input>
    <button type="button" class="lbs-msearch__cancel" data-msearch-close>Cancel</button>
  </form>
</div>

<script>
  (function () {
    var header = document.querySelector('.lbs-header');
    var items = document.querySelectorAll('.lbs-header .lbs-nav-item--mega');
    if (!header || !items.length) return;

    function setMegaTop() {
      var bottom = header.getBoundingClientRect().bottom;
      items.forEach(function (item) {
        var mega = item.querySelector('.lbs-mega');
        if (mega) mega.style.top = bottom + 'px';
      });
    }
    setMegaTop();
    window.addEventListener('scroll', setMegaTop, { passive: true });
    window.addEventListener('resize', setMegaTop);

    var touch = window.matchMedia('(hover: none)').matches;
    items.forEach(function (item) {
      var timer;
      var link = item.querySelector('.lbs-nav-link');

      function open() {
        clearTimeout(timer);
        setMegaTop();
        items.forEach(function (i) { if (i !== item) i.classList.remove('is-open'); });
        item.classList.add('is-open');
      }
      function close() {
        timer = setTimeout(function () { item.classList.remove('is-open'); }, 150);
      }

      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', close);
      if (link) {
        link.addEventListener('focus', open);
        link.addEventListener('click', function (e) {
          if (touch && !item.classList.contains('is-open')) {
            e.preventDefault();
            open();
          }
        });
      }
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.lbs-nav-item--mega')) {
        items.forEach(function (i) { i.classList.remove('is-open'); });
      }
    });
  })();
</script>

<script>
/* ===== Search: inline expand on desktop, popup on mobile ===== */
(function () {
  var wrap = document.querySelector('[data-search]');
  if (!wrap) return;
  var toggle = wrap.querySelector('[data-search-toggle]');
  var input  = wrap.querySelector('.lbs-search__input');
  var form   = wrap.querySelector('.lbs-search__form');
  var mq = window.matchMedia('(max-width: 820px)');

  /* Mobile popup */
  var pop = document.querySelector('[data-msearch]');
  var popInput = pop && pop.querySelector('[data-msearch-input]');
  function openPop()  { if (!pop) return; pop.hidden = false; requestAnimationFrame(function(){ pop.classList.add('is-open'); if (popInput) popInput.focus(); }); }
  function closePop() { if (!pop) return; pop.classList.remove('is-open'); setTimeout(function(){ pop.hidden = true; }, 250); }
  if (pop) {
    pop.querySelector('[data-msearch-close]').addEventListener('click', closePop);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePop(); });
  }

  function openInline()  { wrap.classList.add('is-open'); input.focus(); }
  function closeInline() { wrap.classList.remove('is-open'); }
  toggle.addEventListener('click', function (e) {
    e.preventDefault();
    if (mq.matches) { openPop(); return; }
    if (wrap.classList.contains('is-open')) {
      if (input.value.trim()) { form.submit(); } else { closeInline(); }
    } else { openInline(); }
  });
  document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) closeInline(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeInline(); });
})();

/* ===== Mobile menu drawer ===== */
(function () {
  var burger  = document.querySelector('.lbs-header .burger');
  var menu    = document.querySelector('[data-mmenu]');
  var overlay = document.querySelector('[data-mmenu-overlay]');
  if (!burger || !menu || !overlay) return;
  function open()  { overlay.hidden = false; requestAnimationFrame(function(){ menu.classList.add('is-open'); overlay.classList.add('is-open'); }); menu.setAttribute('aria-hidden','false'); document.body.style.overflow = 'hidden'; }
  function close() { menu.classList.remove('is-open'); overlay.classList.remove('is-open'); menu.setAttribute('aria-hidden','true'); document.body.style.overflow = ''; setTimeout(function(){ overlay.hidden = true; }, 280); }
  burger.addEventListener('click', open);
  menu.querySelector('[data-mmenu-close]').addEventListener('click', close);
  overlay.addEventListener('click', close);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
})();

/* ===== Slide-in cart drawer + AJAX add to cart ===== */
(function () {
  var drawer  = document.querySelector('[data-cart-drawer]');
  var overlay = document.querySelector('[data-cart-overlay]');
  if (!drawer || !overlay) return;
  var body  = drawer.querySelector('[data-cart-body]');
  var foot  = drawer.querySelector('[data-cart-foot]');
  var subEl = drawer.querySelector('[data-cart-subtotal]');
  var counts = document.querySelectorAll('[data-cart-count]');

  function money(cents, currency) {
    try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency || 'USD' }).format(cents / 100); }
    catch (e) { return '$' + (cents / 100).toFixed(2); }
  }
  function openDrawer()  { overlay.hidden = false; drawer.classList.add('is-open'); overlay.classList.add('is-open'); drawer.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
  function closeDrawer() { drawer.classList.remove('is-open'); overlay.classList.remove('is-open'); drawer.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; setTimeout(function(){ overlay.hidden = true; }, 300); }

  var ship    = drawer.querySelector('[data-cart-ship]');
  var shipMs  = drawer.querySelector('[data-ship-ms]');
  var shipMsg = drawer.querySelector('[data-ship-msg]');
  var shipFill= drawer.querySelector('[data-ship-fill]');
  var recsWrap= drawer.querySelector('[data-cart-recs]');
  var recsTrk = drawer.querySelector('[data-recs-track]');
  var shipThreshold = parseFloat(drawer.dataset.freeShip || '0') * 100;

  var ICON_TRASH = '<svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor"><path d="M4.67 14c-.37 0-.68-.13-.95-.39a1.3 1.3 0 0 1-.39-.94V4H2.67V2.67H6V2h4v.67h3.33V4h-.66v8.67c0 .36-.14.68-.4.94-.26.26-.57.39-.94.39H4.67ZM11.33 4H4.67v8.67h6.66V4ZM6 11.33h1.33V5.33H6v6Zm2.67 0H10V5.33H8.67v6Z"/></svg>';
  var ICON_MINUS = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 13H5v-2h14v2z"/></svg>';
  var ICON_PLUS  = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M11 13H5v-2h6V5h2v6h6v2h-6v6h-2z"/></svg>';

  function imgSized(url, w) { return url ? url.replace(/(\.[a-z]+)(\?|$)/i, '_' + w + 'x$1$2') : ''; }

  function updateShip(cart) {
    if (!ship || shipThreshold <= 0) return;
    if (!cart.items || !cart.items.length) { ship.hidden = true; return; }
    ship.hidden = false;
    var total = cart.total_price;
    var remaining = shipThreshold - total;
    var pct = Math.min(100, Math.round((total / shipThreshold) * 100));
    shipFill.style.width = pct + '%';
    if (remaining <= 0) {
      if (shipMs) shipMs.classList.add('is-active');
      shipMsg.innerHTML = 'You’ve unlocked <strong>free shipping</strong>!';
    } else {
      if (shipMs) shipMs.classList.remove('is-active');
      shipMsg.innerHTML = 'You’re <strong>' + money(remaining, cart.currency) + '</strong> away from free shipping';
    }
  }

  function render(cart) {
    counts.forEach(function (c) { c.textContent = cart.item_count; });
    updateShip(cart);
    if (!cart.items || !cart.items.length) {
      body.innerHTML = '<div class="lbs-cd-empty"><p>Your cart is empty!</p><a href="/collections/best-sellers" class="lbs-cd-empty__btn">Shop now</a></div>';
      foot.hidden = true;
      if (recsWrap) recsWrap.hidden = true;
      return;
    }
    foot.hidden = false;
    subEl.textContent = money(cart.items_subtotal_price != null ? cart.items_subtotal_price : cart.total_price, cart.currency);
    body.innerHTML = '<div class="lbs-cd-items">' + cart.items.map(function (it) {
      var img = it.image ? '<img src="' + imgSized(it.image, 180) + '" alt="" width="90" height="120" loading="lazy">' : '';
      var opts = (it.options_with_values || []).filter(function (o) { return o.value && o.value !== 'Default Title'; })
        .map(function (o) { return o.value; }).join(' · ');
      var priceHtml = (it.original_line_price > it.final_line_price)
        ? '<span class="lbs-ci__price">' + money(it.final_line_price, cart.currency) + '</span><span class="lbs-ci__was">' + money(it.original_line_price, cart.currency) + '</span>'
        : '<span class="lbs-ci__price">' + money(it.final_line_price, cart.currency) + '</span>';
      var decIcon = it.quantity <= 1 ? ICON_TRASH : ICON_MINUS;
      return '<div class="lbs-ci" data-key="' + it.key + '">' +
          '<a class="lbs-ci__img" href="' + it.url + '">' + img + '</a>' +
          '<div class="lbs-ci__info">' +
            '<a class="lbs-ci__title" href="' + it.url + '">' + it.product_title + '</a>' +
            (opts ? '<p class="lbs-ci__opts">' + opts + '</p>' : '') +
            '<div class="lbs-ci__row">' +
              '<div class="lbs-ci__qty">' +
                '<button type="button" class="lbs-ci__qbtn" data-qty-dec aria-label="Decrease">' + decIcon + '</button>' +
                '<span class="lbs-ci__qnum">' + it.quantity + '</span>' +
                '<button type="button" class="lbs-ci__qbtn" data-qty-inc aria-label="Increase">' + ICON_PLUS + '</button>' +
              '</div>' +
              '<span class="lbs-ci__prices">' + priceHtml + '</span>' +
            '</div>' +
          '</div>' +
        '</div>';
    }).join('') + '</div>';
    loadRecs(cart);
  }

  /* ===== You may also like ===== */
  var recsLoadedFor = null;
  function loadRecs(cart) {
    if (!recsWrap || !recsTrk || !cart.items.length) { if (recsWrap) recsWrap.hidden = true; return; }
    var pid = cart.items[0].product_id;
    if (recsLoadedFor === pid) return;
    recsLoadedFor = pid;
    var inCart = cart.items.map(function (i) { return i.product_id; });
    fetch('/recommendations/products.json?product_id=' + pid + '&limit=8&intent=related', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var products = (data.products || []).filter(function (p) { return inCart.indexOf(p.id) === -1; }).slice(0, 6);
        if (!products.length) { recsWrap.hidden = true; return; }
        recsTrk.innerHTML = products.map(function (p) {
          var v = (p.variants || []).filter(function (x) { return x.available; })[0] || (p.variants || [])[0];
          if (!v) return '';
          var img = p.featured_image ? '<img src="' + imgSized(p.featured_image, 120) + '" alt="" loading="lazy">' : '';
          return '<div class="lbs-cd-rec">' +
              '<a class="lbs-cd-rec__card" href="' + p.url + '"><span class="lbs-cd-rec__img">' + img + '</span>' +
                '<span class="lbs-cd-rec__info"><span class="lbs-cd-rec__title">' + p.title + '</span>' +
                '<span class="lbs-cd-rec__price">' + money(v.price, cart.currency) + '</span></span></a>' +
              '<button type="button" class="lbs-cd-rec__add" data-add-variant="' + v.id + '">ADD</button>' +
            '</div>';
        }).join('');
        recsWrap.hidden = false;
      })
      .catch(function () { recsWrap.hidden = true; });
  }

  function getCart() { return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); }); }
  function refresh(open) { return getCart().then(function (c) { render(c); if (open) openDrawer(); return c; }); }
  function change(key, qty) {
    return fetch('/cart/change.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(function (r) { return r.json(); }).then(function (c) { recsLoadedFor = null; render(c); return c; });
  }
  function addVariant(id) {
    return fetch('/cart/add.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: id, quantity: 1 })
    }).then(function () { recsLoadedFor = null; return refresh(true); });
  }

  document.querySelectorAll('[data-cart-toggle]').forEach(function (b) {
    b.addEventListener('click', function (e) { e.preventDefault(); refresh(true); });
  });
  drawer.querySelector('[data-cart-close]').addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrawer(); });

  body.addEventListener('click', function (e) {
    var row = e.target.closest('[data-key]');
    if (!row) return;
    var key = row.dataset.key;
    var qty = parseInt((row.querySelector('.lbs-ci__qnum') || {}).textContent || '1', 10);
    if (e.target.closest('[data-qty-inc]')) change(key, qty + 1);
    else if (e.target.closest('[data-qty-dec]')) change(key, Math.max(0, qty - 1));
  });

  if (recsTrk) recsTrk.addEventListener('click', function (e) {
    var add = e.target.closest('[data-add-variant]');
    if (!add) return;
    add.textContent = '…';
    addVariant(add.dataset.addVariant).catch(function () { add.textContent = 'ADD'; });
  });

  /* Intercept every add-to-cart form -> AJAX add -> open drawer */
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || form.getAttribute('action') == null) return;
    if (form.getAttribute('action').indexOf('/cart/add') === -1) return;
    e.preventDefault();
    var btn = form.querySelector('[type="submit"]');
    if (btn) btn.classList.add('is-loading');
    recsLoadedFor = null;
    fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
      .then(function (r) { return r.json(); })
      .then(function () { return refresh(true); })
      .catch(function () { form.submit(); })
      .finally(function () { if (btn) btn.classList.remove('is-loading'); });
  });
})();
</script>

