{%- liquid
  assign blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_to_show
  assign bgs = 'var(--lavender),var(--peach),var(--mint),var(--lime)' | split: ','
-%}

<section class="lbs section">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="blogs">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: limit -%}
          {%- assign bg = bgs[forloop.index0 | modulo: bgs.size] | strip -%}
          <article class="post">
            <a href="{{ article.url }}">
              <div class="post__img" style="background:{{ bg }}">
                {%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy">{%- endif -%}
              </div>
            </a>
            {%- if article.tags.size > 0 -%}<span class="tag">{{ article.tags.first }}</span>{%- endif -%}
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
            <a href="{{ article.url }}" class="read">Read more →</a>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign bg = bgs[forloop.index0 | modulo: bgs.size] | strip -%}
          <article class="post" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}"><div class="post__img" style="background:{{ bg }}">{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">{%- endif -%}</div></a>
            {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
            <h3><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title }}</a></h3>
            {%- if block.settings.excerpt != blank -%}<p>{{ block.settings.excerpt }}</p>{%- endif -%}
            <a href="{{ block.settings.link | default: '#' }}" class="read">Read more →</a>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LBS Blog posts",
  "tag": "section",
  "class": "section-lbs-blog",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Libersens Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn & explore" },
    { "type": "blog", "id": "blog", "label": "Blog (pulls live posts)" },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "paragraph", "content": "If no blog is selected, the placeholder cards below are shown instead." }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Placeholder post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Wellness" },
        { "type": "text", "id": "title", "label": "Title", "default": "The pleasure gap, explained" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "Why it exists, and what the research actually says about closing it." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Blog posts",
      "blocks": [
        { "type": "post", "settings": { "tag": "Wellness", "title": "The pleasure gap, explained", "excerpt": "Why it exists, and what the research actually says about closing it." } },
        { "type": "post", "settings": { "tag": "How-to", "title": "Choosing your first vibrator", "excerpt": "A judgment-free guide to finding what feels right for your body." } },
        { "type": "post", "settings": { "tag": "Intimacy", "title": "Talking pleasure with a partner", "excerpt": "Five conversation starters for deeper, more connected intimacy." } }
      ]
    }
  ]
}
{% endschema %}
