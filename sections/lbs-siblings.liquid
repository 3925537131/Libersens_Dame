<section class="lbs section{% if section.settings.cream_background %} section--cream{% endif %}">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="siblings">
      {%- for block in section.blocks -%}
        <div class="sibling" style="background:{{ block.settings.color }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.name }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="btn btn--primary" style="align-self:flex-start">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LBS Sibling brands",
  "tag": "section",
  "class": "section-lbs-siblings",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The family" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Sibling Brands" },
    { "type": "checkbox", "id": "cream_background", "label": "Cream background", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Bloom & Co." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Plant-powered intimate skincare and bath rituals for the whole body." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "color", "label": "Background color", "default": "#f9e1d5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Sibling brands",
      "blocks": [
        { "type": "brand", "settings": { "name": "Bloom & Co.", "text": "Plant-powered intimate skincare and bath rituals for the whole body.", "button_label": "Explore Bloom", "color": "#f9e1d5" } },
        { "type": "brand", "settings": { "name": "Hush", "text": "Considered home goods and candles designed for slowing down.", "button_label": "Explore Hush", "color": "#def1ee" } }
      ]
    }
  ]
}
{% endschema %}
