<section class="lbs newsletter" id="{{ section.settings.anchor_id | default: 'quiz' }}">
  <div class="newsletter__inner">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="newsletter__klaviyo">
      <div class="klaviyo-form-Xerejc"></div>
    </div>
    {%- if section.settings.fineprint != blank -%}<div class="fineprint">{{ section.settings.fineprint }}</div>{%- endif -%}
  </div>
</section>

<script>
  (function() {
    if (window._klOnsite || document.querySelector('script[src*="klaviyo.com/onsite"]')) return;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=WRqsLJ';
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "LBS Newsletter",
  "tag": "section",
  "class": "section-lbs-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your vibe" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Take our 60-second quiz and get matched with your perfect Libersens — plus 10% off your first order." },
    { "type": "text", "id": "fineprint", "label": "Fine print", "default": "By signing up you agree to receive emails from Libersens. Unsubscribe anytime." },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "quiz" }
  ],
  "presets": [{ "name": "LBS Newsletter" }]
}
{% endschema %}
