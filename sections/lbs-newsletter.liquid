<section class="lbs newsletter" id="{{ section.settings.anchor_id | default: 'quiz' }}">
  <div class="newsletter__inner">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <a href="{{ section.settings.quiz_link | default: '/pages/find-your-vibe' }}" class="newsletter__btn">{{ section.settings.button_label | default: 'Take the quiz' }}</a>
  </div>
</section>

{% schema %}
{
  "name": "LBS Newsletter",
  "tag": "section",
  "class": "section-lbs-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your vibe" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Take our 60-second quiz and get matched with your perfect Libersens — in under two minutes." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take the quiz" },
    { "type": "url", "id": "quiz_link", "label": "Button link (defaults to /pages/find-your-vibe)" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "quiz" }
  ],
  "presets": [{ "name": "LBS Newsletter" }]
}
{% endschema %}
