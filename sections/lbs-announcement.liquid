<div class="lbs lbs-announce">
  <span>{{ section.settings.text }}</span>
  {%- if section.settings.link_label != blank -%}
    <a href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "LBS Announcement bar",
  "tag": "section",
  "class": "section-lbs-announce",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "✦ Free intimate care mini with every order over $75 — this month only" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "LBS Announcement bar" }]
}
{% endschema %}
