<footer class="lbs lbs-footer2" style="--footer-bg:{{ section.settings.bg_color }};--footer-text:{{ section.settings.text_color }};--footer-wave:{{ section.settings.wave_color }}">
  <div class="lbs-footer2__inner">

    {%- if section.settings.show_newsletter -%}
      <div class="lbs-footer2__news">
        <p class="lbs-footer2__news-label">{{ section.settings.newsletter_heading }}</p>
        <div class="lbs-footer2__news-field">
          <div class="klaviyo-form-Xerejc"></div>
          <script>
            if (!document.querySelector('script[src*="static.klaviyo.com/onsite"]')) {
              var klScript = document.createElement('script');
              klScript.async = true;
              klScript.src = 'https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=WRqsLJ';
              document.head.appendChild(klScript);
            }
          </script>
        </div>
      </div>
    {%- endif -%}

    <div class="lbs-footer2__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="lbs-footer2__col" {{ block.shopify_attributes }}>
            <p class="lbs-footer2__col-head">{{ block.settings.heading }}</p>
            <ul class="lbs-footer2__links">
              {%- if block.settings.menu != blank -%}
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- assign rows = block.settings.links | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign label = row | strip -%}
                  {%- if label != blank -%}<li><a href="#">{{ label }}</a></li>{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="lbs-footer2__col lbs-footer2__col--copy">
        <p class="lbs-footer2__col-head">{{ section.settings.copyright_heading }}</p>
        <p class="lbs-footer2__copy">{{ section.settings.logo_text | default: shop.name }}<br>© {{ 'now' | date: '%Y' }}</p>
        {%- if section.settings.legal_text != blank -%}
          <p class="lbs-footer2__legal">{{ section.settings.legal_text }}</p>
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="lbs-footer2__wave" aria-hidden="true">
    <div class="lbs-footer2__wave-track">
      {%- for i in (1..3) -%}
        <svg viewBox="0 0 1780 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 150 C 222 0, 222 0, 445 150 S 668 300, 890 150 S 1112 0, 1335 150 S 1558 300, 1780 150 V300 H0 Z" fill="var(--footer-wave)" opacity="0.55"/>
          <path d="M0 180 C 222 40, 222 40, 445 180 S 668 320, 890 180 S 1112 40, 1335 180 S 1558 320, 1780 180 V320 H0 Z" fill="var(--footer-wave)" opacity="1"/>
        </svg>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "LBS Footer",
  "tag": "section",
  "class": "section-lbs-footer",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Subscribe to our emails" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Input placeholder", "default": "Email" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Submit" },
    { "type": "header", "content": "Copyright column" },
    { "type": "text", "id": "logo_text", "label": "Brand name", "default": "Libersens" },
    { "type": "text", "id": "copyright_heading", "label": "Column heading", "default": "Copyright" },
    { "type": "text", "id": "legal_text", "label": "Legal line", "default": "Terms · Privacy · Accessibility" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0c0c2b" },
    { "type": "color", "id": "wave_color", "label": "Wave", "default": "#fbe8de" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Pick a navigation menu from Online Store → Navigation." },
        { "type": "textarea", "id": "links", "label": "Fallback text (used if no menu picked)", "default": "Vibrators\nPersonal Care\nSexual Health\nBundles" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Product", "links": "Shop\nReturns\nFAQs\nRewards\nRefer a friend" } },
        { "type": "menu", "settings": { "heading": "About", "links": "About Us\nContact Us\nStore Locator\nCareers\nPress" } },
        { "type": "menu", "settings": { "heading": "Social", "links": "Email\nFacebook\nInstagram\nTikTok" } },
        { "type": "menu", "settings": { "heading": "Terms", "links": "Terms & Conditions\nPrivacy Policy\nPatent Info" } }
      ]
    }
  ]
}
{% endschema %}
