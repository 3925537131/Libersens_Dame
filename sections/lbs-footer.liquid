<footer class="lbs lbs-footer">
  <div class="wrap">
    <div class="lbs-footer__top">
      <div class="lbs-footer__brand">
        <span class="lbs-logo">{{ section.settings.logo_text | default: shop.name }}</span>
        {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="lbs-footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {%- if block.settings.menu != blank -%}
              {%- for link in linklists[block.settings.menu].links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- else -%}
              {{ block.settings.links | newline_to_br }}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="lbs-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <div class="lbs-footer__social">
        {%- if settings.social_instagram_link != blank or section.settings.show_social -%}
          <a href="{{ settings.social_instagram_link | default: '#' }}" aria-label="Instagram"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="14" height="14" rx="4"/><circle cx="10" cy="10" r="3.2"/><circle cx="14.5" cy="5.5" r=".6" fill="currentColor"/></svg></a>
          <a href="{{ settings.social_tiktok_link | default: '#' }}" aria-label="TikTok"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 3v9a4 4 0 1 1-3-3.9M13 6a4 4 0 0 0 4 4"/></svg></a>
          <a href="mailto:{{ shop.email }}" aria-label="Email"><svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="16" height="12" rx="2"/><path d="M2 5l8 6 8-6"/></svg></a>
        {%- endif -%}
      </div>
      <span>{{ section.settings.legal_text }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "LBS Footer",
  "tag": "section",
  "class": "section-lbs-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Libersens" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Vibrators and intimate wellness essentials — by women, for women." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "text", "id": "legal_text", "label": "Bottom-right text", "default": "Terms · Privacy · Accessibility" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Pick a navigation menu from Online Store → Navigation." },
        { "type": "textarea", "id": "links", "label": "Fallback text (used if no menu picked)", "default": "Vibrators\nPersonal Care\nSexual Health\nBundles" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop", "links": "Vibrators\nPersonal Care\nSexual Health\nBundles\nSale" } },
        { "type": "menu", "settings": { "heading": "About", "links": "Our Story\nAdvisory Board\nPress\nCareers\nWholesale" } },
        { "type": "menu", "settings": { "heading": "Support", "links": "Contact\nFAQs\nShipping & Returns\nRewards\nRefer a friend" } }
      ]
    }
  ]
}
{% endschema %}
