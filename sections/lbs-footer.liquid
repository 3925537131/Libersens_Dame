<footer class="lbs lbs-footer2" style="--footer-bg:{{ section.settings.bg_color }};--footer-text:{{ section.settings.text_color }};--footer-wave:{{ section.settings.wave_color }}">
  <div class="lbs-footer2__inner">

    {%- if section.settings.show_newsletter -%}
      <div class="lbs-footer2__news">
        <p class="lbs-footer2__news-label">{{ section.settings.newsletter_heading }}</p>
        <div class="lbs-footer2__news-field">
          <form class="lbs-footer2__news-kl" id="lbs-news-{{ section.id }}"
                data-kl-list="{{ section.settings.klaviyo_list_id | default: 'UjUwc5' }}"
                data-kl-company="{{ section.settings.klaviyo_company_id | default: 'WRqsLJ' }}" novalidate>
            <div class="lbs-footer2__news-form">
              <input id="NewsletterFormEmail--footer" class="lbs-footer2__news-input"
                     type="email" name="email" placeholder="Email" aria-label="Email"
                     autocorrect="off" autocapitalize="off" autocomplete="email" required>
              <button type="submit" class="lbs-footer2__news-submit" aria-label="Subscribe">Submit</button>
            </div>
            <div class="lbs-footer2__news-msgs" aria-live="polite">
              <p class="lbs-footer2__news-msg lbs-footer2__news-msg--ok" hidden>Great! You’re on our list.</p>
              <p class="lbs-footer2__news-msg lbs-footer2__news-msg--err" hidden>Oops! That didn’t work. Please try again.</p>
            </div>
          </form>
          <script>
          (function () {
            var form = document.getElementById('lbs-news-{{ section.id }}');
            if (!form) return;
            var input  = form.querySelector('input[type="email"]');
            var okMsg  = form.querySelector('.lbs-footer2__news-msg--ok');
            var errMsg = form.querySelector('.lbs-footer2__news-msg--err');
            var btn    = form.querySelector('.lbs-footer2__news-submit');
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              okMsg.hidden = true; errMsg.hidden = true;
              if (!input.value || !form.checkValidity()) { errMsg.hidden = false; input.focus(); return; }
              btn.disabled = true;
              fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + form.dataset.klCompany, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
                body: JSON.stringify({
                  data: {
                    type: 'subscription',
                    attributes: { profile: { data: { type: 'profile', attributes: { email: input.value.trim() } } } },
                    relationships: { list: { data: { type: 'list', id: form.dataset.klList } } }
                  }
                })
              }).then(function (r) {
                if (r.ok) { okMsg.hidden = false; form.reset(); }
                else { errMsg.hidden = false; }
              }).catch(function () { errMsg.hidden = false; })
                .finally(function () { btn.disabled = false; });
            });
          })();
          </script>
        </div>
      </div>
    {%- endif -%}

    <div class="lbs-footer2__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="lbs-footer2__col" {{ block.shopify_attributes }}>
            <p class="lbs-footer2__col-head">{{ block.settings.heading }}</p>
            <ul class="lbs-footer2__links">
              {%- if block.settings.l1 != blank -%}<li><a href="{{ block.settings.u1 | default: '#' }}">{{ block.settings.l1 }}</a></li>{%- endif -%}
              {%- if block.settings.l2 != blank -%}<li><a href="{{ block.settings.u2 | default: '#' }}">{{ block.settings.l2 }}</a></li>{%- endif -%}
              {%- if block.settings.l3 != blank -%}<li><a href="{{ block.settings.u3 | default: '#' }}">{{ block.settings.l3 }}</a></li>{%- endif -%}
              {%- if block.settings.l4 != blank -%}<li><a href="{{ block.settings.u4 | default: '#' }}">{{ block.settings.l4 }}</a></li>{%- endif -%}
              {%- if block.settings.l5 != blank -%}<li><a href="{{ block.settings.u5 | default: '#' }}">{{ block.settings.l5 }}</a></li>{%- endif -%}
              {%- if block.settings.l6 != blank -%}<li><a href="{{ block.settings.u6 | default: '#' }}">{{ block.settings.l6 }}</a></li>{%- endif -%}
              {%- if block.settings.l7 != blank -%}<li><a href="{{ block.settings.u7 | default: '#' }}">{{ block.settings.l7 }}</a></li>{%- endif -%}
              {%- if block.settings.l8 != blank -%}<li><a href="{{ block.settings.u8 | default: '#' }}">{{ block.settings.l8 }}</a></li>{%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="lbs-footer2__col lbs-footer2__col--copy">
        <p class="lbs-footer2__col-head">{{ section.settings.copyright_heading }}</p>
        <p class="lbs-footer2__copy">{{ section.settings.logo_text | default: shop.name }}<br>© {{ 'now' | date: '%Y' }}</p>
        {%- if section.settings.legal_text != blank -%}
          <p class="lbs-footer2__legal">{{ section.settings.legal_text }}</p>
        {%- endif -%}
      </div>
    </div>

  </div>

  <div class="lbs-footer2__wave" aria-hidden="true">
    <div class="lbs-footer2__wave-track">
      {%- for i in (1..3) -%}
        <svg viewBox="0 0 1780 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 150 C 222 0, 222 0, 445 150 S 668 300, 890 150 S 1112 0, 1335 150 S 1558 300, 1780 150 V300 H0 Z" fill="var(--footer-wave)" opacity="0.55"/>
          <path d="M0 180 C 222 40, 222 40, 445 180 S 668 320, 890 180 S 1112 40, 1335 180 S 1558 320, 1780 180 V320 H0 Z" fill="var(--footer-wave)" opacity="1"/>
        </svg>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "LBS Footer",
  "tag": "section",
  "class": "section-lbs-footer",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Subscribe to our emails" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID", "default": "UjUwc5", "info": "Footer signups subscribe directly to this Klaviyo list." },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo company / site ID", "default": "WRqsLJ" },
    { "type": "header", "content": "Copyright column" },
    { "type": "text", "id": "logo_text", "label": "Brand name", "default": "Libersens" },
    { "type": "text", "id": "copyright_heading", "label": "Column heading", "default": "Copyright" },
    { "type": "text", "id": "legal_text", "label": "Legal line" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#7a5f80" },
    { "type": "color", "id": "wave_color", "label": "Wave", "default": "#fbe8de" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "Column" },
        { "type": "header", "content": "Link 1" },
        { "type": "text", "id": "l1", "label": "Label" },
        { "type": "text", "id": "u1", "label": "URL" },
        { "type": "header", "content": "Link 2" },
        { "type": "text", "id": "l2", "label": "Label" },
        { "type": "text", "id": "u2", "label": "URL" },
        { "type": "header", "content": "Link 3" },
        { "type": "text", "id": "l3", "label": "Label" },
        { "type": "text", "id": "u3", "label": "URL" },
        { "type": "header", "content": "Link 4" },
        { "type": "text", "id": "l4", "label": "Label" },
        { "type": "text", "id": "u4", "label": "URL" },
        { "type": "header", "content": "Link 5" },
        { "type": "text", "id": "l5", "label": "Label" },
        { "type": "text", "id": "u5", "label": "URL" },
        { "type": "header", "content": "Link 6" },
        { "type": "text", "id": "l6", "label": "Label" },
        { "type": "text", "id": "u6", "label": "URL" },
        { "type": "header", "content": "Link 7" },
        { "type": "text", "id": "l7", "label": "Label" },
        { "type": "text", "id": "u7", "label": "URL" },
        { "type": "header", "content": "Link 8" },
        { "type": "text", "id": "l8", "label": "Label" },
        { "type": "text", "id": "u8", "label": "URL" }
      ]
    }
  ],
  "presets": [{ "name": "LBS Footer" }]
}
{% endschema %}
