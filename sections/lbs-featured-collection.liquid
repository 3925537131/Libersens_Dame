{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
  assign cols = section.settings.columns_desktop
  assign bgs = section.settings.card_colors | split: ','
-%}

<section class="lbs section{% if section.settings.cream_background %} section--cream{% endif %}" id="{{ section.settings.anchor_id | default: 'bestsellers' }}">
  <div class="wrap">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
    </div>

    <div class="products" style="--cols:{{ cols }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- assign color_index = forloop.index0 | modulo: bgs.size -%}
          {%- assign bg = bgs[color_index] | strip -%}
          <a class="card" href="{{ product.url }}">
            <div class="card__img" style="background:{{ bg }}">
              {%- if product.compare_at_price > product.price -%}<span class="card__badge">Sale</span>{%- endif -%}
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="300" height="300" loading="lazy">
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="card__body">
              {%- assign rating = product.metafields.reviews.rating.value -%}
              {%- if rating -%}
                <div class="card__rating"><span class="stars">★★★★★</span> {{ product.metafields.reviews.rating_count }} reviews</div>
              {%- endif -%}
              <div class="card__name">{{ product.title }}</div>
              {%- if product.description != blank -%}<div class="card__desc">{{ product.description | strip_html | truncatewords: 7 }}</div>{%- endif -%}
              <div class="card__row">
                <span class="card__price">{{ product.price | money }}</span>
                <span class="card__add">View</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Onboarding placeholders shown until a collection is chosen {%- endcomment -%}
        {%- for i in (1..5) -%}
          {%- assign color_index = forloop.index0 | modulo: bgs.size -%}
          {%- assign bg = bgs[color_index] | strip -%}
          <div class="card">
            <div class="card__img" style="background:{{ bg }}">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__body">
              <div class="card__name">Example product {{ i }}</div>
              <div class="card__row"><span class="card__price">$0.00</span><span class="card__add">View</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.button_label != blank -%}
      <div class="center-cta">
        <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LBS Featured collection",
  "tag": "section",
  "class": "section-lbs-featured",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tried & adored" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Bestsellers" },
    { "type": "text", "id": "description", "label": "Description", "default": "The pieces our community reaches for again and again." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 5 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "cream_background", "label": "Cream background", "default": true },
    { "type": "text", "id": "anchor_id", "label": "Anchor id (for in-page links)", "default": "bestsellers" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all products" },
    { "type": "text", "id": "card_colors", "label": "Card background colors (comma-separated)", "info": "Cycles through these behind product images.", "default": "var(--peach),var(--lavender),var(--mint),var(--lime),#f0efef" }
  ],
  "presets": [{ "name": "LBS Featured collection" }]
}
{% endschema %}
