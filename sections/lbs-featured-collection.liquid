{%- liquid
  assign collection = collections['best-sellers']
  if collection == blank
    assign collection = collections[section.settings.collection]
  endif
  assign limit = section.settings.products_to_show
  assign cols = section.settings.columns_desktop
-%}

<section class="lbs section{% if section.settings.cream_background %} section--cream{% endif %}" id="{{ section.settings.anchor_id | default: 'bestsellers' }}">
  <div class="wrap">

    <div class="bs-head">
      <div class="bs-head__text">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all and section.settings.button_label != blank -%}
        <a class="bs-seeall" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="bs-carousel" id="bs-{{ section.id }}" style="--cols:{{ cols }};--bs-card-bg:{{ section.settings.card_bg }}">
      <div class="bs-track" data-bs-track>
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: limit -%}
            {%- liquid
              assign badge_text = ''
              assign badge_out = false
              unless product.available
                assign badge_text = 'Sold out'
                assign badge_out = true
              else
                if product.tags contains 'bestseller' or product.tags contains 'Bestseller'
                  assign badge_text = 'Bestseller'
                elsif product.tags contains 'new' or product.tags contains 'New'
                  assign badge_text = 'New'
                endif
              endunless

              assign opt_label = '1 Option'
              unless product.has_only_default_variant
                assign fo = product.options_with_values[0]
                assign oc = fo.values | size
                assign on = fo.name | downcase
                if on contains 'colour' or on contains 'color'
                  assign unit = 'Colors'
                  if oc == 1
                    assign unit = 'Color'
                  endif
                elsif on contains 'size'
                  assign unit = 'Sizes'
                  if oc == 1
                    assign unit = 'Size'
                  endif
                else
                  assign unit = 'Options'
                  if oc == 1
                    assign unit = 'Option'
                  endif
                endif
                assign opt_label = oc | append: ' ' | append: unit
              endunless
            -%}
            <article class="bs-card{% if badge_out %} bs-card--out{% endif %}">
              <a class="bs-card__media" href="{{ product.url }}">
                {%- if badge_text != blank -%}<span class="bs-badge{% if badge_out %} bs-badge--out{% endif %}">{{ badge_text }}</span>{%- endif -%}
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="300" height="366" loading="lazy">
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="bs-card__info">
                <h3 class="bs-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <div class="bs-card__opt">{{ opt_label }}</div>

                {%- if product.available -%}
                  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="bs-add-form">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="bs-add">Add to cart <span class="bs-add__sep">|</span> {{ product.price | money_without_trailing_zeros }}</button>
                  </form>
                {%- else -%}
                  <button type="button" class="bs-add bs-add--out" disabled>Sold out</button>
                {%- endif -%}

                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="bs-card__rating">
                    <span class="num">{{ product.metafields.reviews.rating.value.rating | round: 1 }}</span>
                    <span class="stars">★★★★★</span>
                    <span class="count">{{ product.metafields.reviews.rating_count }} reviews</span>
                  </div>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Onboarding demo cards shown until a collection is chosen {%- endcomment -%}
          {%- assign demo_names = 'Vela Wearable,Luna Panty Vibe,Mira Mini Wand,Aura Aloe Lube,Sol Palm Vibe,Nova Bullet,Iris Ring' | split: ',' -%}
          {%- assign demo_prices = '$129,$79,$76,$19,$103,$45,$59' | split: ',' -%}
          {%- assign demo_opts = '2 Colors,1 Option,2 Colors,2 Sizes,2 Colors,1 Option,2 Colors' | split: ',' -%}
          {%- assign demo_badge = 'Bestseller,New,,,,New,' | split: ',' -%}
          {%- for i in (1..7) -%}
            {%- assign idx = forloop.index0 -%}
            <article class="bs-card">
              <div class="bs-card__media">
                {%- assign b = demo_badge[idx] | strip -%}
                {%- if b != blank -%}<span class="bs-badge">{{ b }}</span>{%- endif -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="bs-card__info">
                <h3 class="bs-card__name">{{ demo_names[idx] | strip }}</h3>
                <div class="bs-card__opt">{{ demo_opts[idx] | strip }}</div>
                <button type="button" class="bs-add">Add to cart <span class="bs-add__sep">|</span> {{ demo_prices[idx] | strip }}</button>
                <div class="bs-card__rating"><span class="num">4.8</span> <span class="stars">★★★★★</span> <span class="count">1,200 reviews</span></div>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="bs-foot">
        <div class="bs-progress"><span class="bs-progress__fill" data-bs-fill></span></div>
        <div class="bs-nav">
          <button type="button" class="bs-arrow" data-bs-prev aria-label="Previous">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button type="button" class="bs-arrow" data-bs-next aria-label="Next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('bs-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-bs-track]');
    var fill = root.querySelector('[data-bs-fill]');
    var prev = root.querySelector('[data-bs-prev]');
    var next = root.querySelector('[data-bs-next]');

    function stepSize() {
      var card = track.querySelector('.bs-card');
      if (!card) return track.clientWidth;
      var styles = getComputedStyle(track);
      var gap = parseInt(styles.columnGap || styles.gap, 10) || 20;
      return card.offsetWidth + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var ratio = max > 0 ? (track.scrollLeft + track.clientWidth) / track.scrollWidth : 1;
      if (fill) fill.style.width = Math.min(100, Math.max(8, ratio * 100)) + '%';
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max - 2;
    }

    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -stepSize(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: stepSize(), behavior: 'smooth' }); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "LBS Featured collection",
  "tag": "section",
  "class": "section-lbs-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Bestsellers" },
    { "type": "text", "id": "description", "label": "Subheading", "default": "Community favorites for pleasure and play." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "columns_desktop", "label": "Cards visible on desktop", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#f6f4f1" },
    { "type": "checkbox", "id": "cream_background", "label": "Cream section background", "default": false },
    { "type": "text", "id": "anchor_id", "label": "Anchor id (for in-page links)", "default": "bestsellers" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'See all' button", "default": true },
    { "type": "text", "id": "button_label", "label": "'See all' label", "default": "See all" }
  ],
  "presets": [{ "name": "LBS Featured collection" }]
}
{% endschema %}
