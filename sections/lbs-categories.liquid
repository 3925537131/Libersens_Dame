<section class="lbs lbs-categories2" id="{{ section.settings.anchor_id | default: 'categories' }}">
  <div class="wrap">

    <div class="lbs-cat2-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="lbs-cat2-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                alt="{{ block.settings.title | escape }}"
                class="lbs-cat2-card__img"
                width="900" height="1150"
                loading="lazy"
              >
            {%- else -%}
              <div class="lbs-cat2-card__placeholder" style="background:linear-gradient(135deg,{{ block.settings.color | default: '#c4c3f2' }},{{ block.settings.color | default: '#c4c3f2' | color_lighten: 18 }})"></div>
            {%- endif -%}
            <div class="lbs-cat2-card__overlay"></div>
            <div class="lbs-cat2-card__content">
              {%- if block.settings.badge != blank -%}
                <span class="lbs-cat2-badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              <h3 class="lbs-cat2-title">{{ block.settings.title }}</h3>
              <div class="lbs-cat2-btn">Shop</div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_quiz_bar -%}
      <div class="lbs-quiz-bar">
        <p class="lbs-quiz-bar__text">{{ section.settings.quiz_text | default: 'Not sure which toy is right for you? Find Your Vibe' }}</p>
        <a href="{{ section.settings.quiz_link | default: '#quiz' }}" class="lbs-quiz-bar__btn">{{ section.settings.quiz_btn | default: 'Take our quiz' | upcase }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "LBS Categories",
  "tag": "section",
  "class": "section-lbs-categories",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "categories" },
    { "type": "header", "content": "Quiz bar" },
    { "type": "checkbox", "id": "show_quiz_bar", "label": "Show quiz bar", "default": true },
    { "type": "text", "id": "quiz_text", "label": "Quiz bar text", "default": "Not sure which toy is right for you? Find Your Vibe" },
    { "type": "text", "id": "quiz_btn", "label": "Button label", "default": "Take our quiz" },
    { "type": "url", "id": "quiz_link", "label": "Quiz link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "badge", "label": "Badge tag (top-left)", "default": "Vibrators" },
        { "type": "text", "id": "title", "label": "Category title", "default": "Vibrators" },
        { "type": "url", "id": "link", "label": "Shop link" },
        { "type": "color", "id": "color", "label": "Placeholder color (no image)", "default": "#c4c3f2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LBS Categories",
      "blocks": [
        { "type": "category", "settings": { "badge": "Vibrators", "title": "Vibrators", "color": "#c4c3f2" } },
        { "type": "category", "settings": { "badge": "Accessories", "title": "Accessories", "color": "#f9e1d5" } }
      ]
    }
  ]
}
{% endschema %}
