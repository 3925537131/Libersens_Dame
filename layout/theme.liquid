<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_header | default: '#261b22' }}">

    <title>
      {{ page_title }}
      {% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}
      {% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}

    <style>
      :root {
        --color-ink: {{ settings.color_ink | default: '#211d20' }};
        --color-background: {{ settings.color_background | default: '#fffaf7' }};
        --color-surface: {{ settings.color_surface | default: '#ffffff' }};
        --color-accent: {{ settings.color_accent | default: '#8a2447' }};
        --color-secondary: {{ settings.color_secondary | default: '#0e5b5f' }};
        --color-header: {{ settings.color_header | default: '#261b22' }};
        --color-gold: {{ settings.color_gold | default: '#c79b63' }};
      }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900;1,9..40,400;1,9..40,700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {%- comment -%} Pre-define jdgm global site-wide so Judge.me's inline data scripts never throw ReferenceError {%- endcomment -%}
    <script>window.jdgm = window.jdgm || {};</script>
  </head>

  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'community-banner' %}
    {% section 'footer' %}

    {%- comment -%}
      ── Review badge (bottom-right pill) — sitewide ───────────────────────────
      Shows the store-wide average rating from Judge.me shop metafields.
      Falls back to the flagship product's data if shop-level avg isn't synced.
      Change 'she-bell-2' to whichever product has the most reviews.
    {%- endcomment -%}
    {%- assign shop_review_count = shop.metafields.judgeme.shop_reviews_count | default: 0 -%}
    {%- assign shop_review_avg   = shop.metafields.judgeme.avg_rating           | default: 0 -%}
    {%- assign review_source     = all_products['she-bell-2'] -%}

    <script id="ShopReviewData" type="application/json">
    {
      "shopAvg":   {{ shop_review_avg | times: 1.0 }},
      "shopCount": {{ shop_review_count }},
      "sourceId":  {{ review_source.id | default: 0 }}
    }
    </script>

    <div id="ReviewBadge" class="review-badge" hidden>
      <span class="review-badge__star" aria-hidden="true">★</span>
      <span class="review-badge__avg"></span>
      <span class="review-badge__divider" aria-hidden="true"></span>
      <span class="review-badge__count"></span>
    </div>

    {%- comment -%}
      ── Review toast (bottom-left) — non-product pages only ──────────────────
      On product pages, main-product.liquid injects its own ProductReviewData
      and ReviewToast using the current product's Judge.me reviews.
    {%- endcomment -%}
    {%- unless template == 'product' -%}
      {%- if review_source.metafields.judgeme.review_widget_data != blank -%}

        <script>
          window.jdgm = window.jdgm || {};
          jdgm.data = jdgm.data || {};
          jdgm.data.reviewWidget = jdgm.data.reviewWidget || {};
          jdgm.data.reviewWidget[{{ review_source.id }}] = {{ review_source.metafields.judgeme.review_widget_data }};
        </script>

        <script id="ProductReviewData" type="application/json">{"productId": {{ review_source.id }}}</script>

        <div id="ReviewToast" class="review-toast" hidden>
          <button class="review-toast__close" aria-label="Close">×</button>
          <div class="review-toast__avatar" aria-hidden="true"></div>
          <div class="review-toast__content">
            <div class="review-toast__name"></div>
            <div class="review-toast__stars"></div>
            <div class="review-toast__text"></div>
          </div>
        </div>

      {%- endif -%}
    {%- endunless -%}

  </body>
</html>
