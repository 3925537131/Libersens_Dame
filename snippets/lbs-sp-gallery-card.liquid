{%- comment -%}
  Renders one SP-gallery card's inner content (image + icon title + subtitle).
  Used by both the desktop grid and the mobile carousel so markup stays in sync.
  Params: image, icon (package|silicone|water|warranty), title, subtitle,
          grad_top, grad_bottom, accent
{%- endcomment -%}

<div class="product-sp-gallery__image-wrap">
  {%- if image != blank -%}
    <img src="{{ image | image_url: width: 900 }}"
         alt="{{ title | escape }}"
         srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w"
         width="900" height="1090" loading="lazy"
         sizes="(min-width: 750px) 24vw, 100vw"
         class="product-sp-gallery__image">
  {%- else -%}
    {%- comment -%} Pastel placeholder — upload a photo via the block image picker to replace it {%- endcomment -%}
    <svg class="product-sp-gallery__image" viewBox="0 0 460 560" role="img" aria-label="{{ title | escape }} placeholder" xmlns="http://www.w3.org/2000/svg">
      <rect x="0" y="0" width="460" height="560" rx="24" fill="#e2d1dd"/>
      <g fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" opacity="0.65">
        <rect x="150" y="210" width="160" height="120" rx="12"/>
        <circle cx="192" cy="248" r="13"/>
        <path d="M163 318 L214 270 L252 304 L286 276 L297 286"/>
      </g>
    </svg>
  {%- endif -%}
</div>

<div class="product-sp-gallery__title-wrap">
  {%- render 'lbs-sp-icon', icon: icon, color: '' -%}
  <h3 class="product-sp-gallery__title">{{ title }}</h3>
</div>

<p class="product-sp-gallery__subtitle">{{ subtitle }}</p>
