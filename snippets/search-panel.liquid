<div id="SearchPanel" class="search-panel" aria-hidden="true" data-search-panel>
  <div class="search-panel__backdrop" data-search-close></div>
  <aside class="search-panel__inner" role="search" aria-label="Product search">

    <div class="search-panel__head">
      <span class="search-panel__head-label">Search</span>
      <button class="search-panel__close-btn" data-search-close aria-label="Close search" type="button">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 3L17 17M17 3L3 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="search-panel__bar">
      <svg class="search-panel__bar-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>
        <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <input
        class="search-panel__input"
        type="search"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="Search products…"
        data-search-input
        aria-label="Search products"
      >
    </div>

    <div class="search-panel__results" data-search-results aria-live="polite"></div>

    <div class="search-panel__trending" data-search-trending>
      <p class="search-panel__trending-label">Popular</p>
      <div class="search-panel__trending-pills">
        <a href="/products/she-bell-2" class="search-panel__pill">She Bell</a>
        <a href="/products/petite" class="search-panel__pill">Petite</a>
        <a href="/products/aura" class="search-panel__pill">Aura</a>
        <a href="/collections/best-sellers" class="search-panel__pill">Best sellers</a>
      </div>
    </div>

  </aside>
</div>
