{%- comment -%}
  Reusable Libersens product card. Usage: {% render 'lbs-product-card', product: product %}
{%- endcomment -%}
{%- liquid
  assign badge_text = ''
  assign badge_out = false
  unless product.available
    assign badge_text = 'Sold out'
    assign badge_out = true
  else
    if product.tags contains 'bestseller' or product.tags contains 'Bestseller'
      assign badge_text = 'Bestseller'
    elsif product.tags contains 'new' or product.tags contains 'New'
      assign badge_text = 'New'
    endif
  endunless

  assign opt_label = '1 Option'
  unless product.has_only_default_variant
    assign fo = product.options_with_values[0]
    assign oc = fo.values | size
    assign on = fo.name | downcase
    if on contains 'colour' or on contains 'color'
      assign unit = 'Colors'
      if oc == 1
        assign unit = 'Color'
      endif
    elsif on contains 'size'
      assign unit = 'Sizes'
      if oc == 1
        assign unit = 'Size'
      endif
    else
      assign unit = 'Options'
      if oc == 1
        assign unit = 'Option'
      endif
    endif
    assign opt_label = oc | append: ' ' | append: unit
  endunless
-%}
<article class="bs-card{% if badge_out %} bs-card--out{% endif %}">
  <a class="bs-card__media" href="{{ product.url }}">
    {%- if badge_text != blank -%}<span class="bs-badge{% if badge_out %} bs-badge--out{% endif %}">{{ badge_text }}</span>{%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="300" height="366" loading="lazy">
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="bs-card__info">
    <h3 class="bs-card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="bs-card__opt">{{ opt_label }}</div>
    {%- if product.available -%}
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="bs-add-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="bs-add">Add to cart <span class="bs-add__sep">|</span> {{ product.price | money_without_trailing_zeros }}</button>
      </form>
    {%- else -%}
      <button type="button" class="bs-add bs-add--out" disabled>Sold out</button>
    {%- endif -%}
    {%- if product.metafields.reviews.rating.value != blank -%}
      <div class="bs-card__rating">
        <span class="num">{{ product.metafields.reviews.rating.value.rating | round: 1 }}</span>
        <span class="stars">★★★★★</span>
        <span class="count">{{ product.metafields.reviews.rating_count }} reviews</span>
      </div>
    {%- endif -%}
  </div>
</article>
